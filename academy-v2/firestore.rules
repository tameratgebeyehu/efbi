    function validVersionedRevisionDraftFast(data, submissionId, uid) {
      return validVersionedRevisionSubmissionShapeFast(data, submissionId, uid)
        && data.status == 'draft'
        && validEvidence(data.evidence, false)
        && data.consentVersion == ''
        && data.consentAcceptedAt == null
        && data.submittedAt == null;
