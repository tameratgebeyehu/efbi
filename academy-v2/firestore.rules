rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function admin() {
      return verified()
        && 'admin' in request.auth.token
        && request.auth.token.admin == true;
    }

    function reviewer() {
      return verified()
        && 'reviewer' in request.auth.token
        && request.auth.token.reviewer == true;
    }

    function enrollmentOpen() {
      return exists(/databases/$(database)/documents/publicSettings/enrollment)
        && get(/databases/$(database)/documents/publicSettings/enrollment).data.open == true;
    }

    function validEnrollmentSettings(data) {
      return data.keys().hasOnly(['open', 'minAge', 'updatedAt', 'updatedBy'])
        && data.open is bool
        && data.minAge == 12
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid;
    }

    function validDisplayName(name) {
      return name is string && name.size() >= 2 && name.size() <= 80;
    }

    function validProfile(data) {
      return data.keys().hasOnly([
          'displayName', 'status', 'ageBand', 'privacyNoticeVersion',
          'privacyAcceptedAt', 'learnerSafetyVersion',
          'learnerSafetyAcceptedAt', 'createdAt', 'updatedAt'
        ])
        && validDisplayName(data.displayName)
        && data.status == 'active'
        && data.ageBand == '16-plus'
        && data.privacyNoticeVersion == 'efbi-self-registration-privacy-v1'
        && data.privacyAcceptedAt == request.time
        && data.learnerSafetyVersion == 'efbi-learner-safety-v1'
        && data.learnerSafetyAcceptedAt == request.time
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function hasLearnerProfile(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function validLegacyProgress(data, courseId) {
      let publishedLessonIds = ['understanding-ai', 'prompting-with-purpose', 'responsible-use', 'build-an-ethiopian-solution'];
      let validFirstLesson = data.completedLessonIds == ['understanding-ai']
        && data.lastLessonId == 'understanding-ai'
        && data.percent == 25;
      let validSecondLesson = data.completedLessonIds == ['understanding-ai', 'prompting-with-purpose']
        && data.lastLessonId == 'prompting-with-purpose'
        && data.percent == 50;
      let validThirdLesson = data.completedLessonIds == ['understanding-ai', 'prompting-with-purpose', 'responsible-use']
        && data.lastLessonId == 'responsible-use'
        && data.percent == 75;
      let validFourthLesson = data.completedLessonIds == ['understanding-ai', 'prompting-with-purpose', 'responsible-use', 'build-an-ethiopian-solution']
        && data.lastLessonId == 'build-an-ethiopian-solution'
        && data.percent == 100;
      return data.keys().hasOnly([
          'courseId',
          'completedLessonIds',
          'lastLessonId',
          'percent',
          'createdAt',
          'updatedAt'
        ])
        && courseId == 'ai-foundations'
        && data.courseId == courseId
        && data.completedLessonIds is list
        && data.completedLessonIds.size() >= 1
        && data.completedLessonIds.size() <= 4
        && data.completedLessonIds.toSet().size() == data.completedLessonIds.size()
        && data.completedLessonIds.toSet().difference(publishedLessonIds.toSet()).size() == 0
        && data.lastLessonId in data.completedLessonIds
        && (validFirstLesson || validSecondLesson || validThirdLesson || validFourthLesson)
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function validCourseContent(data) {
      return data.title is string
        && data.title.size() >= 5
        && data.title.size() <= 100
        && data.summary is string
        && data.summary.size() >= 20
        && data.summary.size() <= 240
        && data.description is string
        && data.description.size() >= 40
        && data.description.size() <= 4000
        && validCourseCategory(data.category)
        && data.level in ['beginner', 'intermediate', 'advanced']
        && data.language is string
        && data.language.size() >= 2
        && data.language.size() <= 40
        && data.estimatedMinutes is int
        && data.estimatedMinutes >= 15
        && data.estimatedMinutes <= 20000;
    }

    function validCourseId(courseId) {
      return courseId is string
        && courseId.size() >= 3
        && courseId.size() <= 64
        && courseId.matches('[a-z0-9]+(-[a-z0-9]+)*');
    }

    function validCourseDraft(data, courseId) {
      return data.keys().hasOnly([
          'courseId',
          'title',
          'summary',
          'description',
          'category',
          'level',
          'language',
          'estimatedMinutes',
          'status',
          'revision',
          'latestReleaseNumber',
          'latestReleaseId',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy',
          'lastAuditId'
        ])
        && validCourseId(courseId)
        && data.courseId == courseId
        && validCourseContent(data)
        && data.status in ['draft', 'ready', 'published']
        && data.revision is int
        && data.revision >= 1
        && data.latestReleaseNumber is int
        && data.latestReleaseNumber >= 0
        && data.latestReleaseId is string
        && data.latestReleaseId.size() <= 120
        && data.createdAt is timestamp
        && data.createdBy is string
        && data.createdBy.size() > 0
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid
        && data.lastAuditId is string
        && data.lastAuditId.size() >= 16
        && data.lastAuditId.size() <= 180;
    }

    function validPracticeQuestion(data) {
      return data.keys().hasOnly(['enabled', 'prompt', 'options', 'correctOption', 'explanation'])
        && data.enabled is bool
        && data.prompt is string
        && data.options is list
        && data.options.size() == 3
        && data.options[0] is string
        && data.options[1] is string
        && data.options[2] is string
        && data.correctOption is int
        && data.explanation is string
        && (
          (
            data.enabled == false
            && data.prompt == ''
            && data.options == ['', '', '']
            && data.correctOption == 0
            && data.explanation == ''
          )
          ||
          (
            data.enabled == true
            && data.prompt.size() >= 12
            && data.prompt.size() <= 240
            && data.options[0].size() >= 1
            && data.options[0].size() <= 160
            && data.options[1].size() >= 1
            && data.options[1].size() <= 160
            && data.options[2].size() >= 1
            && data.options[2].size() <= 160
            && data.correctOption >= 0
            && data.correctOption <= 2
            && data.explanation.size() >= 12
            && data.explanation.size() <= 300
          )
        );
    }

    function validProgramId(programId) {
      return programId is string
        && programId.size() >= 3
        && programId.size() <= 64
        && programId.matches('[a-z0-9]+(-[a-z0-9]+)*');
    }

    function validCourseCategory(category) {
      return category in ['artificial-intelligence', 'app-development', 'web-development', 'mobile-development']
        || (
          validProgramId(category)
          && exists(/databases/$(database)/documents/programDrafts/$(category))
        );
    }

    function validProgramContent(data) {
      return data.title is string
        && data.title.size() >= 3
        && data.title.size() <= 80
        && data.shortTitle is string
        && data.shortTitle.size() >= 2
        && data.shortTitle.size() <= 16
        && data.description is string
        && data.description.size() >= 20
        && data.description.size() <= 500
        && data.outcome is string
        && data.outcome.size() >= 20
        && data.outcome.size() <= 300
        && data.level in ['beginner', 'intermediate', 'advanced']
        && data.durationWeeks is int
        && data.durationWeeks >= 1
        && data.durationWeeks <= 52
        && data.accent in ['green', 'gold', 'blue', 'red']
        && data.order is int
        && data.order >= 1
        && data.order <= 50;
    }

    function validProgramDraft(data, programId) {
      return data.keys().hasOnly([
          'programId', 'title', 'shortTitle', 'description', 'outcome',
          'level', 'durationWeeks', 'accent', 'order', 'status', 'revision',
          'latestReleaseNumber', 'latestReleaseId', 'createdAt', 'createdBy',
          'updatedAt', 'updatedBy', 'lastAuditId'
        ])
        && validProgramId(programId)
        && data.programId == programId
        && validProgramContent(data)
        && data.status in ['draft', 'ready', 'published']
        && data.revision is int
        && data.revision >= 1
        && data.latestReleaseNumber is int
        && data.latestReleaseNumber >= 0
        && data.latestReleaseId is string
        && data.latestReleaseId.size() <= 120
        && data.createdAt is timestamp
        && data.createdBy is string
        && data.createdBy.size() > 0
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid
        && data.lastAuditId is string
        && data.lastAuditId.size() >= 16
        && data.lastAuditId.size() <= 180;
    }

    function validPostId(postId) {
      return postId is string
        && postId.size() >= 3
        && postId.size() <= 80
        && postId.matches('[a-z0-9]+(-[a-z0-9]+)*');
    }

    function validBlogContent(data) {
      return data.title is string
        && data.title.size() >= 5
        && data.title.size() <= 120
        && data.excerpt is string
        && data.excerpt.size() >= 20
        && data.excerpt.size() <= 320
        && data.category is string
        && data.category.size() >= 2
        && data.category.size() <= 40
        && data.authorName is string
        && data.authorName.size() >= 2
        && data.authorName.size() <= 80
        && data.readingMinutes is int
        && data.readingMinutes >= 1
        && data.readingMinutes <= 60
        && data.featured is bool
        && data.tone in ['green', 'gold', 'blue', 'red']
        && data.bodyMarkdown is string
        && data.bodyMarkdown.size() >= 100
        && data.bodyMarkdown.size() <= 20000;
    }

    function validBlogDraft(data, postId) {
      return data.keys().hasOnly([
          'postId', 'title', 'excerpt', 'category', 'authorName',
          'readingMinutes', 'featured', 'tone', 'bodyMarkdown', 'status',
          'revision', 'latestReleaseNumber', 'latestReleaseId', 'createdAt',
          'createdBy', 'updatedAt', 'updatedBy', 'lastAuditId'
        ])
        && validPostId(postId)
        && data.postId == postId
        && validBlogContent(data)
        && data.status in ['draft', 'ready', 'published', 'unpublished']
        && data.revision is int
        && data.revision >= 1
        && data.latestReleaseNumber is int
        && data.latestReleaseNumber >= 0
        && data.latestReleaseId is string
        && data.latestReleaseId.size() <= 140
        && data.createdAt is timestamp
        && data.createdBy is string
        && data.createdBy.size() > 0
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid
        && data.lastAuditId is string
        && data.lastAuditId.size() >= 16
        && data.lastAuditId.size() <= 180;
    }

    function validPracticeQuestionV2(data) {
      return data.keys().hasOnly(['prompt', 'options', 'correctOption', 'explanation'])
        && data.prompt is string
        && data.prompt.size() >= 12
        && data.prompt.size() <= 240
        && data.options is list
        && data.options.size() == 3
        && data.options[0] is string
        && data.options[0].size() >= 1
        && data.options[0].size() <= 160
        && data.options[1] is string
        && data.options[1].size() >= 1
        && data.options[1].size() <= 160
        && data.options[2] is string
        && data.options[2].size() >= 1
        && data.options[2].size() <= 160
        && data.correctOption is int
        && data.correctOption >= 0
        && data.correctOption <= 2
        && data.explanation is string
        && data.explanation.size() >= 12
        && data.explanation.size() <= 300;
    }

    function validPracticeQuestionList(questions) {
      return questions is list
        && questions.size() <= 3
        && (questions.size() < 1 || validPracticeQuestionV2(questions[0]))
        && (questions.size() < 2 || validPracticeQuestionV2(questions[1]))
        && (questions.size() < 3 || validPracticeQuestionV2(questions[2]));
    }

    function validLessonId(lessonId) {
      return lessonId is string
        && lessonId.size() >= 3
        && lessonId.size() <= 64
        && lessonId.matches('[a-z0-9]+(-[a-z0-9]+)*');
    }

    function validLessonIdList(lessonIds) {
      return lessonIds is list
        && lessonIds.size() >= 1
        && lessonIds.size() <= 12
        && lessonIds.toSet().size() == lessonIds.size()
        && validLessonId(lessonIds[0])
        && (lessonIds.size() < 2 || validLessonId(lessonIds[1]))
        && (lessonIds.size() < 3 || validLessonId(lessonIds[2]))
        && (lessonIds.size() < 4 || validLessonId(lessonIds[3]))
        && (lessonIds.size() < 5 || validLessonId(lessonIds[4]))
        && (lessonIds.size() < 6 || validLessonId(lessonIds[5]))
        && (lessonIds.size() < 7 || validLessonId(lessonIds[6]))
        && (lessonIds.size() < 8 || validLessonId(lessonIds[7]))
        && (lessonIds.size() < 9 || validLessonId(lessonIds[8]))
        && (lessonIds.size() < 10 || validLessonId(lessonIds[9]))
        && (lessonIds.size() < 11 || validLessonId(lessonIds[10]))
        && (lessonIds.size() < 12 || validLessonId(lessonIds[11]));
    }

    function validCourseVersion(data, versionId) {
      return data.keys().hasOnly([
          'versionId', 'courseId', 'courseTitle', 'courseVersion',
          'assessmentVersion', 'assessmentType', 'lessonIds',
          'publishedAt', 'publishedBy', 'auditId'
        ])
        && data.versionId == versionId
        && validCourseId(data.courseId)
        && data.courseTitle is string
        && data.courseTitle.size() >= 5
        && data.courseTitle.size() <= 100
        && data.courseVersion is int
        && data.courseVersion >= 1
        && data.courseVersion <= 10000
        && data.assessmentVersion is int
        && data.assessmentVersion >= 1
        && data.assessmentVersion <= 10000
        && data.assessmentType in ['practice-only', 'project']
        && validLessonIdList(data.lessonIds)
        && data.publishedAt == request.time
        && data.publishedBy == request.auth.uid
        && data.auditId is string
        && data.auditId.size() >= 16
        && data.auditId.size() <= 180;
    }

    function validActiveCourse(data, courseId) {
      let version = getAfter(/databases/$(database)/documents/courseVersions/$(data.versionId)).data;
      return data.keys().hasOnly([
          'courseId', 'versionId', 'courseVersion', 'courseTitle',
          'lessonCount', 'assessmentVersion', 'assessmentType',
          'activatedAt', 'activatedBy', 'auditId'
        ])
        && data.courseId == courseId
        && validCourseId(courseId)
        && data.versionId is string
        && data.versionId.size() >= 8
        && data.versionId.size() <= 140
        && version.versionId == data.versionId
        && version.courseId == courseId
        && data.courseVersion == version.courseVersion
        && data.courseTitle == version.courseTitle
        && data.lessonCount == version.lessonIds.size()
        && data.assessmentVersion == version.assessmentVersion
        && data.assessmentType == version.assessmentType
        && data.activatedAt == request.time
        && data.activatedBy == request.auth.uid
        && data.auditId == version.auditId;
    }

    function validPublicLessonOutline(outline, version, index) {
      return outline.keys().hasOnly(['lessonId', 'title', 'summary', 'order', 'durationMinutes'])
        && outline.lessonId == version.lessonIds[index]
        && validLessonId(outline.lessonId)
        && outline.title is string
        && outline.title.size() >= 5
        && outline.title.size() <= 100
        && outline.summary is string
        && outline.summary.size() >= 20
        && outline.summary.size() <= 240
        && outline.order == index + 1
        && outline.durationMinutes is int
        && outline.durationMinutes >= 1
        && outline.durationMinutes <= 240;
    }

    function validPublicLessonOutlines(data, version) {
      return data.lessonOutlines is list
        && data.lessonOutlines.size() == version.lessonIds.size()
        && data.lessonOutlines.size() >= 1
        && data.lessonOutlines.size() <= 12
        && validPublicLessonOutline(data.lessonOutlines[0], version, 0)
        && (data.lessonOutlines.size() < 2 || validPublicLessonOutline(data.lessonOutlines[1], version, 1))
        && (data.lessonOutlines.size() < 3 || validPublicLessonOutline(data.lessonOutlines[2], version, 2))
        && (data.lessonOutlines.size() < 4 || validPublicLessonOutline(data.lessonOutlines[3], version, 3))
        && (data.lessonOutlines.size() < 5 || validPublicLessonOutline(data.lessonOutlines[4], version, 4))
        && (data.lessonOutlines.size() < 6 || validPublicLessonOutline(data.lessonOutlines[5], version, 5))
        && (data.lessonOutlines.size() < 7 || validPublicLessonOutline(data.lessonOutlines[6], version, 6))
        && (data.lessonOutlines.size() < 8 || validPublicLessonOutline(data.lessonOutlines[7], version, 7))
        && (data.lessonOutlines.size() < 9 || validPublicLessonOutline(data.lessonOutlines[8], version, 8))
        && (data.lessonOutlines.size() < 10 || validPublicLessonOutline(data.lessonOutlines[9], version, 9))
        && (data.lessonOutlines.size() < 11 || validPublicLessonOutline(data.lessonOutlines[10], version, 10))
        && (data.lessonOutlines.size() < 12 || validPublicLessonOutline(data.lessonOutlines[11], version, 11));
    }

    function validPublicCourseCatalog(data, courseId) {
      let version = getAfter(/databases/$(database)/documents/courseVersions/$(data.versionId)).data;
      let active = getAfter(/databases/$(database)/documents/activeCourses/$(courseId)).data;
      let release = getAfter(/databases/$(database)/documents/courseReleases/$(data.courseReleaseId)).data;
      return data.keys().hasOnly([
          'courseId', 'versionId', 'courseReleaseId', 'courseVersion',
          'courseTitle', 'courseDescription', 'level', 'language',
          'estimatedMinutes', 'lessonCount', 'assessmentVersion',
          'assessmentType', 'lessonOutlines', 'publishedAt'
        ])
        && data.courseId == courseId
        && validCourseId(courseId)
        && version.versionId == data.versionId
        && version.courseId == courseId
        && active.versionId == data.versionId
        && active.courseId == courseId
        && data.courseVersion == version.courseVersion
        && data.courseVersion == active.courseVersion
        && data.courseTitle == version.courseTitle
        && data.courseTitle == release.title
        && data.courseDescription == release.summary
        && data.level == release.level
        && data.language == release.language
        && data.estimatedMinutes == release.estimatedMinutes
        && release.releaseId == data.courseReleaseId
        && release.courseId == courseId
        && release.version == data.courseVersion
        && data.lessonCount == version.lessonIds.size()
        && data.lessonCount == active.lessonCount
        && data.assessmentVersion == version.assessmentVersion
        && data.assessmentVersion == active.assessmentVersion
        && data.assessmentType == version.assessmentType
        && data.assessmentType == active.assessmentType
        && validPublicLessonOutlines(data, version)
        && data.publishedAt == request.time
        && version.auditId == active.auditId;
    }

    function validVersionedProgress(data, courseId) {
      let version = get(/databases/$(database)/documents/courseVersions/$(data.versionId)).data;
      return data.keys().hasOnly([
          'courseId', 'versionId', 'courseVersion', 'lessonCount',
          'completedLessonIds', 'lastLessonId', 'createdAt', 'updatedAt'
        ])
        && data.courseId == courseId
        && validCourseId(courseId)
        && data.versionId is string
        && version.versionId == data.versionId
        && version.courseId == courseId
        && data.courseVersion == version.courseVersion
        && data.lessonCount == version.lessonIds.size()
        && data.completedLessonIds is list
        && data.completedLessonIds.size() >= 1
        && data.completedLessonIds.size() <= data.lessonCount
        && data.completedLessonIds.toSet().size() == data.completedLessonIds.size()
        && data.completedLessonIds.toSet().difference(version.lessonIds.toSet()).size() == 0
        && data.lastLessonId in data.completedLessonIds
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function validProgress(data, courseId) {
      return data.keys().hasAll(['versionId'])
        ? validVersionedProgress(data, courseId)
        : validLegacyProgress(data, courseId);
    }

    function versionedProgressStartsAtFirstLesson(data, courseId) {
      let version = get(/databases/$(database)/documents/courseVersions/$(data.versionId)).data;
      let activeCourse = get(/databases/$(database)/documents/activeCourses/$(courseId)).data;
      return validVersionedProgress(data, courseId)
        && activeCourse.courseId == courseId
        && activeCourse.versionId == data.versionId
        && data.completedLessonIds == [version.lessonIds[0]]
        && data.lastLessonId == version.lessonIds[0]
        && data.createdAt == request.time;
    }

    function versionedProgressAddsNextLesson(data, previous, courseId) {
      let version = get(/databases/$(database)/documents/courseVersions/$(data.versionId)).data;
      return previous.keys().hasAll(['versionId'])
        && validVersionedProgress(data, courseId)
        && data.versionId == previous.versionId
        && data.courseVersion == previous.courseVersion
        && data.lessonCount == previous.lessonCount
        && data.createdAt == previous.createdAt
        && data.completedLessonIds.size() == previous.completedLessonIds.size() + 1
        && previous.completedLessonIds.toSet().difference(data.completedLessonIds.toSet()).size() == 0
        && data.lastLessonId == version.lessonIds[previous.completedLessonIds.size()];
    }

    function validLegacyLessonContent(data) {
      return validCourseId(data.courseId)
        && validLessonId(data.lessonId)
        && data.order is int
        && data.order >= 1
        && data.order <= 50
        && data.title is string
        && data.title.size() >= 5
        && data.title.size() <= 100
        && data.summary is string
        && data.summary.size() >= 20
        && data.summary.size() <= 240
        && data.durationMinutes is int
        && data.durationMinutes >= 5
        && data.durationMinutes <= 300
        && data.videoYoutubeId is string
        && (data.videoYoutubeId == '' || data.videoYoutubeId.matches('[A-Za-z0-9_-]{11}'))
        && data.bodyMarkdown is string
        && data.bodyMarkdown.size() >= 100
        && data.bodyMarkdown.size() <= 12000
        && validPracticeQuestion(data.question1)
        && validPracticeQuestion(data.question2)
        && validPracticeQuestion(data.question3);
    }

    function validVersionedLessonContent(data) {
      return validCourseId(data.courseId)
        && validLessonId(data.lessonId)
        && data.order is int
        && data.order >= 1
        && data.order <= 50
        && data.title is string
        && data.title.size() >= 5
        && data.title.size() <= 100
        && data.summary is string
        && data.summary.size() >= 20
        && data.summary.size() <= 240
        && data.durationMinutes is int
        && data.durationMinutes >= 5
        && data.durationMinutes <= 300
        && data.videoYoutubeId is string
        && (data.videoYoutubeId == '' || data.videoYoutubeId.matches('[A-Za-z0-9_-]{11}'))
        && data.bodyMarkdown is string
        && data.bodyMarkdown.size() >= 100
        && data.bodyMarkdown.size() <= 12000
        && validPracticeQuestionList(data.questions);
    }

    function validLessonContent(data) {
      return data.keys().hasAll(['questions'])
        ? validVersionedLessonContent(data)
        : validLegacyLessonContent(data);
    }

    function validLessonDraftKeys(data) {
      return data.keys().hasAll(['questions'])
        ? data.keys().hasOnly([
            'lessonId', 'courseId', 'order', 'title', 'summary',
            'durationMinutes', 'videoYoutubeId', 'bodyMarkdown', 'questions',
            'status', 'revision', 'latestReleaseNumber', 'latestReleaseId',
            'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'lastAuditId'
          ])
        : data.keys().hasOnly([
            'lessonId', 'courseId', 'order', 'title', 'summary',
            'durationMinutes', 'videoYoutubeId', 'bodyMarkdown', 'question1',
            'question2', 'question3', 'status', 'revision',
            'latestReleaseNumber', 'latestReleaseId', 'createdAt', 'createdBy',
            'updatedAt', 'updatedBy', 'lastAuditId'
          ]);
    }

    function validLessonDraft(data, lessonId) {
      return validLessonDraftKeys(data)
        && data.lessonId == lessonId
        && validLessonContent(data)
        && data.status in ['draft', 'ready', 'published']
        && data.revision is int
        && data.revision >= 1
        && data.latestReleaseNumber is int
        && data.latestReleaseNumber >= 0
        && data.latestReleaseId is string
        && data.latestReleaseId.size() <= 120
        && data.createdAt is timestamp
        && data.createdBy is string
        && data.createdBy.size() > 0
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid
        && data.lastAuditId is string
        && data.lastAuditId.size() >= 16
        && data.lastAuditId.size() <= 180;
