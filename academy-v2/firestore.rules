rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function admin() {
      return verified()
        && 'admin' in request.auth.token
        && request.auth.token.admin == true;
    }

    function reviewer() {
      return verified()
        && 'reviewer' in request.auth.token
        && request.auth.token.reviewer == true;
    }

    function validDisplayName(name) {
      return name is string && name.size() >= 2 && name.size() <= 80;
    }

    function validProfile(data) {
      return data.keys().hasOnly(['displayName', 'status', 'createdAt', 'updatedAt'])
        && validDisplayName(data.displayName)
        && data.status == 'active'
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validProgress(data, courseId) {
      let publishedLessonIds = ['understanding-ai', 'prompting-with-purpose', 'responsible-use', 'build-an-ethiopian-solution'];
      let validFirstLesson = data.completedLessonIds == ['understanding-ai']
        && data.lastLessonId == 'understanding-ai'
        && data.percent == 25;
      let validSecondLesson = data.completedLessonIds == ['understanding-ai', 'prompting-with-purpose']
        && data.lastLessonId == 'prompting-with-purpose'
        && data.percent == 50;
      let validThirdLesson = data.completedLessonIds == ['understanding-ai', 'prompting-with-purpose', 'responsible-use']
        && data.lastLessonId == 'responsible-use'
        && data.percent == 75;
      let validFourthLesson = data.completedLessonIds == ['understanding-ai', 'prompting-with-purpose', 'responsible-use', 'build-an-ethiopian-solution']
        && data.lastLessonId == 'build-an-ethiopian-solution'
        && data.percent == 100;
      return data.keys().hasOnly([
          'courseId',
          'completedLessonIds',
          'lastLessonId',
          'percent',
          'createdAt',
          'updatedAt'
        ])
        && courseId == 'ai-foundations'
        && data.courseId == courseId
        && data.completedLessonIds is list
        && data.completedLessonIds.size() >= 1
        && data.completedLessonIds.size() <= 4
        && data.completedLessonIds.toSet().size() == data.completedLessonIds.size()
        && data.completedLessonIds.toSet().difference(publishedLessonIds.toSet()).size() == 0
        && data.lastLessonId in data.completedLessonIds
        && (validFirstLesson || validSecondLesson || validThirdLesson || validFourthLesson)
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function validCertificate(data, credentialId) {
      return data.keys().hasOnly([
          'credentialId',
          'learnerName',
          'courseId',
          'courseTitle',
          'issuedAt',
          'status',
          'public',
          'updatedAt'
        ])
        && data.credentialId == credentialId
        && data.learnerName is string
        && data.learnerName.size() >= 2
        && data.learnerName.size() <= 80
        && data.courseId is string
        && data.courseTitle is string
        && data.issuedAt is timestamp
        && data.status in ['active', 'revoked', 'replaced']
        && data.public == true
        && data.updatedAt == request.time;
    }

    function validCourseContent(data) {
      return data.title is string
        && data.title.size() >= 5
        && data.title.size() <= 100
        && data.summary is string
        && data.summary.size() >= 20
        && data.summary.size() <= 240
        && data.description is string
        && data.description.size() >= 40
        && data.description.size() <= 4000
        && data.category in ['artificial-intelligence', 'app-development', 'web-development', 'mobile-development']
        && data.level in ['beginner', 'intermediate', 'advanced']
        && data.language is string
        && data.language.size() >= 2
        && data.language.size() <= 40
        && data.estimatedMinutes is int
        && data.estimatedMinutes >= 15
        && data.estimatedMinutes <= 20000;
    }

    function validCourseId(courseId) {
      return courseId is string
        && courseId.size() >= 3
        && courseId.size() <= 64
        && courseId.matches('[a-z0-9]+(-[a-z0-9]+)*');
    }

    function validCourseDraft(data, courseId) {
      return data.keys().hasOnly([
          'courseId',
          'title',
          'summary',
          'description',
          'category',
          'level',
          'language',
          'estimatedMinutes',
          'status',
          'revision',
          'latestReleaseNumber',
          'latestReleaseId',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy',
          'lastAuditId'
        ])
        && validCourseId(courseId)
        && data.courseId == courseId
        && validCourseContent(data)
        && data.status in ['draft', 'ready', 'published']
        && data.revision is int
        && data.revision >= 1
        && data.latestReleaseNumber is int
        && data.latestReleaseNumber >= 0
        && data.latestReleaseId is string
        && data.latestReleaseId.size() <= 120
        && data.createdAt is timestamp
        && data.createdBy is string
        && data.createdBy.size() > 0
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid
        && data.lastAuditId is string
        && data.lastAuditId.size() >= 16
        && data.lastAuditId.size() <= 180;
    }

    function validPracticeQuestion(data) {
      return data.keys().hasOnly(['enabled', 'prompt', 'options', 'correctOption', 'explanation'])
        && data.enabled is bool
        && data.prompt is string
        && data.options is list
        && data.options.size() == 3
        && data.options[0] is string
        && data.options[1] is string
        && data.options[2] is string
        && data.correctOption is int
        && data.explanation is string
        && (
          (
            data.enabled == false
            && data.prompt == ''
            && data.options == ['', '', '']
            && data.correctOption == 0
            && data.explanation == ''
          )
          ||
          (
            data.enabled == true
            && data.prompt.size() >= 12
            && data.prompt.size() <= 240
            && data.options[0].size() >= 1
            && data.options[0].size() <= 160
            && data.options[1].size() >= 1
            && data.options[1].size() <= 160
            && data.options[2].size() >= 1
            && data.options[2].size() <= 160
            && data.correctOption >= 0
            && data.correctOption <= 2
            && data.explanation.size() >= 12
            && data.explanation.size() <= 300
          )
        );
    }

    function validLessonId(lessonId) {
      return lessonId is string
        && lessonId.size() >= 3
        && lessonId.size() <= 64
        && lessonId.matches('[a-z0-9]+(-[a-z0-9]+)*');
    }

    function validLessonContent(data) {
      return validCourseId(data.courseId)
        && validLessonId(data.lessonId)
        && data.order is int
        && data.order >= 1
        && data.order <= 50
        && data.title is string
        && data.title.size() >= 5
        && data.title.size() <= 100
        && data.summary is string
        && data.summary.size() >= 20
        && data.summary.size() <= 240
        && data.durationMinutes is int
        && data.durationMinutes >= 5
        && data.durationMinutes <= 300
        && data.videoYoutubeId is string
        && (data.videoYoutubeId == '' || data.videoYoutubeId.matches('[A-Za-z0-9_-]{11}'))
        && data.bodyMarkdown is string
        && data.bodyMarkdown.size() >= 100
        && data.bodyMarkdown.size() <= 12000
        && validPracticeQuestion(data.question1)
        && validPracticeQuestion(data.question2)
        && validPracticeQuestion(data.question3);
    }

    function validLessonDraft(data, lessonId) {
      return data.keys().hasOnly([
          'lessonId',
          'courseId',
          'order',
          'title',
          'summary',
          'durationMinutes',
          'videoYoutubeId',
          'bodyMarkdown',
          'question1',
          'question2',
          'question3',
          'status',
          'revision',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy',
          'lastAuditId'
        ])
        && data.lessonId == lessonId
        && validLessonContent(data)
        && data.status in ['draft', 'ready']
        && data.revision is int
        && data.revision >= 1
        && data.createdAt is timestamp
        && data.createdBy is string
        && data.createdBy.size() > 0
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid
        && data.lastAuditId is string
        && data.lastAuditId.size() >= 16
        && data.lastAuditId.size() <= 180;
    }

    function sameLessonContent() {
      return request.resource.data.lessonId == resource.data.lessonId
        && request.resource.data.courseId == resource.data.courseId
        && request.resource.data.order == resource.data.order
        && request.resource.data.title == resource.data.title
        && request.resource.data.summary == resource.data.summary
        && request.resource.data.durationMinutes == resource.data.durationMinutes
        && request.resource.data.videoYoutubeId == resource.data.videoYoutubeId
        && request.resource.data.bodyMarkdown == resource.data.bodyMarkdown
        && request.resource.data.question1 == resource.data.question1
        && request.resource.data.question2 == resource.data.question2
        && request.resource.data.question3 == resource.data.question3;
    }
    function validAuditEvent(data, eventId) {
      return data.keys().hasOnly([
          'eventId', 'action', 'entityType', 'entityId', 'actorUid',
          'revision', 'releaseId', 'createdAt'
        ])
        && data.eventId == eventId
        && data.action in ['course.draft.created', 'course.draft.updated', 'course.release.published', 'lesson.draft.created', 'lesson.draft.updated']
        && data.entityType in ['courseDraft', 'courseRelease', 'lessonDraft']
        && validCourseId(data.entityId)
        && data.actorUid == request.auth.uid
        && data.revision is int
        && data.revision >= 1
        && data.releaseId is string
        && data.releaseId.size() <= 120
        && data.createdAt == request.time;
    }

    function linkedAuditIsValid(auditId, action, entityType, entityId, revision, releaseId) {
      let event = getAfter(/databases/$(database)/documents/adminAudit/$(auditId)).data;
      return event.eventId == auditId
        && event.action == action
        && event.entityType == entityType
        && event.entityId == entityId
        && event.actorUid == request.auth.uid
        && event.revision == revision
        && event.releaseId == releaseId
        && event.createdAt == request.time;
    }

    function sameCourseContent() {
      return request.resource.data.title == resource.data.title
        && request.resource.data.summary == resource.data.summary
        && request.resource.data.description == resource.data.description
        && request.resource.data.category == resource.data.category
        && request.resource.data.level == resource.data.level
        && request.resource.data.language == resource.data.language
        && request.resource.data.estimatedMinutes == resource.data.estimatedMinutes;
    }

    function validCourseRelease(data, releaseId) {
      return data.keys().hasOnly([
          'releaseId', 'courseId', 'title', 'summary', 'description',
          'category', 'level', 'language', 'estimatedMinutes', 'version',
          'draftRevision', 'publishedAt', 'publishedBy', 'auditId'
        ])
        && data.releaseId == releaseId
        && releaseId.size() >= 16
        && releaseId.size() <= 120
        && validCourseId(data.courseId)
        && validCourseContent(data)
        && data.version is int
        && data.version >= 1
        && data.draftRevision is int
        && data.draftRevision >= 2
        && data.publishedAt == request.time
        && data.publishedBy == request.auth.uid
        && data.auditId is string
        && data.auditId.size() >= 16
        && data.auditId.size() <= 180;
    }

    function releaseMatchesPublishedDraft(data, releaseId) {
      let draft = getAfter(/databases/$(database)/documents/courseDrafts/$(data.courseId)).data;
      return draft.status == 'published'
        && draft.latestReleaseId == releaseId
        && draft.latestReleaseNumber == data.version
        && draft.revision == data.draftRevision
        && draft.lastAuditId == data.auditId
        && draft.title == data.title
        && draft.summary == data.summary
        && draft.description == data.description
        && draft.category == data.category
        && draft.level == data.level
        && draft.language == data.language
        && draft.estimatedMinutes == data.estimatedMinutes;
    }

    function auditLinksToCourseOperation(data, eventId) {
      let draft = getAfter(/databases/$(database)/documents/courseDrafts/$(data.entityId)).data;
      let lesson = getAfter(/databases/$(database)/documents/lessonDrafts/$(data.entityId)).data;
      return (
          data.entityType == 'courseDraft'
          && data.action in ['course.draft.created', 'course.draft.updated']
          && draft.lastAuditId == eventId
          && draft.revision == data.revision
          && draft.latestReleaseId == data.releaseId
          && draft.updatedBy == request.auth.uid
        )
        || (
          data.entityType == 'courseRelease'
          && data.action == 'course.release.published'
          && draft.status == 'published'
          && draft.lastAuditId == eventId
          && draft.revision == data.revision
          && draft.latestReleaseId == data.releaseId
          && draft.updatedBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/courseReleases/$(data.releaseId)).data.auditId == eventId
          && getAfter(/databases/$(database)/documents/courseReleases/$(data.releaseId)).data.courseId == data.entityId
          && getAfter(/databases/$(database)/documents/courseReleases/$(data.releaseId)).data.publishedBy == request.auth.uid
        )
        || (
          data.entityType == 'lessonDraft'
          && data.action in ['lesson.draft.created', 'lesson.draft.updated']
          && lesson.lastAuditId == eventId
          && lesson.revision == data.revision
          && lesson.updatedBy == request.auth.uid
          && data.releaseId == ''
        );
    }

    match /users/{uid} {
      allow create: if owns(uid) && validProfile(request.resource.data);
      allow get: if owns(uid) || admin();
      allow list: if admin();
      allow update: if owns(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt'])
        && validDisplayName(request.resource.data.displayName)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /progress/{courseId} {
        allow get, list: if owns(uid) || admin();
        allow create: if owns(uid)
          && verified()
          && validProgress(request.resource.data, courseId)
          && request.resource.data.completedLessonIds == ['understanding-ai']
          && request.resource.data.createdAt == request.time;
        allow update: if owns(uid)
          && verified()
          && validProgress(request.resource.data, courseId)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.completedLessonIds.size() == resource.data.completedLessonIds.size() + 1
          && request.resource.data.percent == resource.data.percent + 25
          && resource.data.completedLessonIds.toSet()
            .difference(request.resource.data.completedLessonIds.toSet()).size() == 0;
        allow delete: if false;
      }

      match /submissions/{submissionId} {
        allow read, write: if false;
      }
    }

    match /certificates/{credentialId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if admin() && validCertificate(request.resource.data, credentialId);
      allow delete: if false;
    }

    // Drafts remain private. Every accepted change requires a linked immutable
    // audit event written in the same atomic operation.
    match /courseDrafts/{courseId} {
      allow get, list: if admin();
      allow create: if admin()
        && validCourseDraft(request.resource.data, courseId)
        && request.resource.data.status == 'draft'
        && request.resource.data.revision == 1
        && request.resource.data.latestReleaseNumber == 0
        && request.resource.data.latestReleaseId == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && linkedAuditIsValid(
          request.resource.data.lastAuditId,
          'course.draft.created',
          'courseDraft',
          courseId,
          1,
          ''
        );
      allow update: if admin()
        && validCourseDraft(request.resource.data, courseId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.revision == resource.data.revision + 1
        && (
          (
            request.resource.data.status in ['draft', 'ready']
            && (request.resource.data.status != resource.data.status
              || !sameCourseContent())
            && request.resource.data.latestReleaseNumber == resource.data.latestReleaseNumber
            && request.resource.data.latestReleaseId == resource.data.latestReleaseId
            && linkedAuditIsValid(
              request.resource.data.lastAuditId,
              'course.draft.updated',
              'courseDraft',
              courseId,
              request.resource.data.revision,
              request.resource.data.latestReleaseId
            )
          )
          ||
          (
            resource.data.status == 'ready'
            && request.resource.data.status == 'published'
            && sameCourseContent()
            && request.resource.data.latestReleaseNumber == resource.data.latestReleaseNumber + 1
            && request.resource.data.latestReleaseId != ''
            && request.resource.data.latestReleaseId != resource.data.latestReleaseId
            && linkedAuditIsValid(
              request.resource.data.lastAuditId,
              'course.release.published',
              'courseRelease',
              courseId,
              request.resource.data.revision,
              request.resource.data.latestReleaseId
            )
            && getAfter(/databases/$(database)/documents/courseReleases/$(request.resource.data.latestReleaseId)).data.courseId == courseId
            && getAfter(/databases/$(database)/documents/courseReleases/$(request.resource.data.latestReleaseId)).data.version == request.resource.data.latestReleaseNumber
            && getAfter(/databases/$(database)/documents/courseReleases/$(request.resource.data.latestReleaseId)).data.draftRevision == request.resource.data.revision
            && getAfter(/databases/$(database)/documents/courseReleases/$(request.resource.data.latestReleaseId)).data.auditId == request.resource.data.lastAuditId
          )
        );
      allow delete: if false;

      match /{document=**} {
        allow read: if admin();
        allow write: if false;
      }
    }

    // Published releases are immutable snapshots. Phase 11 will connect the
    // student catalog after migration and compatibility tests.
    match /courseReleases/{releaseId} {
      allow get, list: if verified();
      allow create: if admin()
        && validCourseRelease(request.resource.data, releaseId)
        && linkedAuditIsValid(
          request.resource.data.auditId,
          'course.release.published',
          'courseRelease',
          request.resource.data.courseId,
          request.resource.data.draftRevision,
          releaseId
        )
        && releaseMatchesPublishedDraft(request.resource.data, releaseId);
      allow update, delete: if false;
    }

    // Lesson drafts are private authoring records. Phase 11 keeps them out of
    // the student catalog until migration and progress compatibility are tested.
    match /lessonDrafts/{lessonId} {
      allow get, list: if admin();
      allow create: if admin()
        && validLessonDraft(request.resource.data, lessonId)
        && request.resource.data.status == 'draft'
        && request.resource.data.revision == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && linkedAuditIsValid(
          request.resource.data.lastAuditId,
          'lesson.draft.created',
          'lessonDraft',
          lessonId,
          1,
          ''
        );
      allow update: if admin()
        && validLessonDraft(request.resource.data, lessonId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.status in ['draft', 'ready']
        && (request.resource.data.status != resource.data.status || !sameLessonContent())
        && linkedAuditIsValid(
          request.resource.data.lastAuditId,
          'lesson.draft.updated',
          'lessonDraft',
          lessonId,
          request.resource.data.revision,
          ''
        );
      allow delete: if false;
    }
    match /reviewAssignments/{assignmentId} {
      allow get, list: if admin() || reviewer();
      allow create, update, delete: if false;
    }

    match /adminAudit/{eventId} {
      allow get, list: if admin();
      allow create: if admin()
        && validAuditEvent(request.resource.data, eventId)
        && auditLinksToCourseOperation(request.resource.data, eventId);
      allow update, delete: if false;
    }

    match /courses/{courseId} {
      allow read: if verified();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
