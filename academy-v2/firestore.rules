    function validVersionedOriginalFinalFast(data, submissionId) {
      return validVersionedOriginalSubmissionShapeFast(data, submissionId)
        && data.status == 'submitted'
        && data.projectTitle.size() >= 5
        && data.problemStatement.size() >= 40
        && data.intendedUsers.size() >= 10
        && data.solutionSummary.size() >= 50
        && data.reflection.size() >= 50
        && data.aiUseDisclosure.size() >= 20
        && validEvidence(data.evidence, true)
        && data.consentVersion == 'efbi-project-consent-v1'
        && data.consentAcceptedAt == request.time
        && data.submittedAt == request.time;
    }

    function validVersionedRevisionFinalFast(data, submissionId, uid) {
      return validVersionedRevisionSubmissionShapeFast(data, submissionId, uid)
        && data.status == 'submitted'
        && data.projectTitle.size() >= 5
        && data.problemStatement.size() >= 40
        && data.intendedUsers.size() >= 10
        && data.solutionSummary.size() >= 50
        && data.reflection.size() >= 50
        && data.aiUseDisclosure.size() >= 20
        && validEvidence(data.evidence, true)
        && data.consentVersion == 'efbi-project-revision-consent-v1'
        && data.consentAcceptedAt == request.time
        && data.submittedAt == request.time;
    }

    function versionedOriginalSubmissionUpdateAllowed(uid, submissionId) {
      return completedVersionedSubmissionCourse(uid, request.resource.data)
        && resource.data.status == 'draft'
        && sameVersionedSubmissionIdentityFast()
        && validVersionedOriginalSubmissionShapeFast(request.resource.data, submissionId)
        && (
          (
            request.resource.data.status == 'draft'
            && validEvidence(request.resource.data.evidence, false)
            && request.resource.data.consentVersion == ''
            && request.resource.data.consentAcceptedAt == null
            && request.resource.data.submittedAt == null
          )
          || (
            request.resource.data.status == 'submitted'
            && request.resource.data.projectTitle.size() >= 5
            && request.resource.data.problemStatement.size() >= 40
            && request.resource.data.intendedUsers.size() >= 10
            && request.resource.data.solutionSummary.size() >= 50
            && request.resource.data.reflection.size() >= 50
            && request.resource.data.aiUseDisclosure.size() >= 20
            && validEvidence(request.resource.data.evidence, true)
            && request.resource.data.consentVersion == 'efbi-project-consent-v1'
            && request.resource.data.consentAcceptedAt == request.time
            && request.resource.data.submittedAt == request.time
          )
        );
    }

    function versionedRevisionSubmissionUpdateAllowed(uid, submissionId) {
      return completedVersionedSubmissionCourse(uid, request.resource.data)
        && resource.data.status == 'draft'
        && sameVersionedSubmissionIdentityFast()
        && validVersionedRevisionSubmissionShapeFast(request.resource.data, submissionId, uid)
        && (
          (
            request.resource.data.status == 'draft'
            && validEvidence(request.resource.data.evidence, false)
            && request.resource.data.consentVersion == ''
            && request.resource.data.consentAcceptedAt == null
            && request.resource.data.submittedAt == null
          )
          || (
            request.resource.data.status == 'submitted'
            && request.resource.data.projectTitle.size() >= 5
            && request.resource.data.problemStatement.size() >= 40
            && request.resource.data.intendedUsers.size() >= 10
            && request.resource.data.solutionSummary.size() >= 50
            && request.resource.data.reflection.size() >= 50
            && request.resource.data.aiUseDisclosure.size() >= 20
            && validEvidence(request.resource.data.evidence, true)
            && request.resource.data.consentVersion == 'efbi-project-revision-consent-v1'
            && request.resource.data.consentAcceptedAt == request.time
            && request.resource.data.submittedAt == request.time
          )
        );
    }

    function revisionIsAllowed(uid, data) {
      let originalId = data.keys().hasAll(['versionId'])
        ? versionedOriginalSubmissionId(data)
        : 'ai-foundations-project';
      let original = get(/databases/$(database)/documents/users/$(uid)/submissions/$(originalId)).data;
      let result = get(/databases/$(database)/documents/users/$(uid)/reviewResults/$(uid + '--' + originalId)).data;
      return original.status == 'submitted'
        && result.learnerUid == uid
        && result.submissionId == originalId
        && result.decision == 'revision_requested';
    }

    function originalSubmission(data, submissionId) {
      return data.keys().hasAll(['versionId'])
        ? submissionId == versionedOriginalSubmissionId(data)
        : submissionId == 'ai-foundations-project';
    }

    function revisionSubmission(data, submissionId) {
      return data.keys().hasAll(['versionId'])
        ? submissionId == versionedRevisionSubmissionId(data)
        : submissionId == 'ai-foundations-project-revision-1';
    }

    function sameSubmissionIdentity() {
      return request.resource.data.submissionId == resource.data.submissionId
        && request.resource.data.courseId == resource.data.courseId
        && request.resource.data.courseVersion == resource.data.courseVersion
        && request.resource.data.assessmentVersion == resource.data.assessmentVersion
        && (
          (
            !request.resource.data.keys().hasAny(['versionId'])
            && !resource.data.keys().hasAny(['versionId'])
          )
          || (
            request.resource.data.versionId == resource.data.versionId
          )
        )
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function assignedReviewer(uid, submissionId) {
      let assignmentId = uid + '--' + submissionId;
      let assignment = get(/databases/$(database)/documents/reviewAssignments/$(assignmentId)).data;
      return reviewer()
        && assignment.learnerUid == uid
        && assignment.submissionId == submissionId
        && assignment.reviewerUid == request.auth.uid
        && assignment.status == 'assigned';
    }

    function validRubricScore(value) {
      return value is int && value >= 0 && value <= 2;
    }

    function validReviewScores(scores) {
      return scores is map
        && scores.keys().hasOnly([
          'localProblem', 'usefulSolution', 'evidence',
          'safetyResponsibility', 'explanationReflection'
        ])
        && validRubricScore(scores.localProblem)
        && validRubricScore(scores.usefulSolution)
        && validRubricScore(scores.evidence)
        && validRubricScore(scores.safetyResponsibility)
        && validRubricScore(scores.explanationReflection);
    }

    function rubricTotal(scores) {
      return scores.localProblem
        + scores.usefulSolution
        + scores.evidence
        + scores.safetyResponsibility
        + scores.explanationReflection;
    }

    function validReviewDecision(data) {
      return (
          data.decision == 'approved'
          && data.totalScore >= 8
          && data.scores.safetyResponsibility >= 1
          && data.concern == 'none'
        )
        || (
          data.decision == 'revision_requested'
          && (
            data.totalScore < 8
            || data.scores.safetyResponsibility == 0
            || data.concern != 'none'
          )
        );
    }

    function validReviewBinding(data, resultId) {
      let assignment = get(/databases/$(database)/documents/reviewAssignments/$(resultId)).data;
      let submission = get(/databases/$(database)/documents/users/$(data.learnerUid)/submissions/$(data.submissionId)).data;
      return resultId == data.learnerUid + '--' + data.submissionId
        && assignment.assignmentId == resultId
        && assignment.learnerUid == data.learnerUid
        && assignment.submissionId == data.submissionId
        && assignment.reviewerUid == request.auth.uid
        && assignment.status == 'assigned'
        && submission.status == 'submitted'
        && submission.courseVersion == data.courseVersion
        && submission.assessmentVersion == data.assessmentVersion
        && submission.submittedAt == data.submissionSubmittedAt
        && validSubmissionId(submission, data.submissionId)
        && (
          (
            submission.keys().hasAll(['versionId'])
            && data.keys().hasAll(['courseId', 'versionId'])
            && data.courseId == submission.courseId
            && data.versionId == submission.versionId
          )
          || (
            !submission.keys().hasAny(['versionId'])
            && !data.keys().hasAny(['courseId', 'versionId'])
          )
        );
    }

    function validPrivateReviewResult(data, resultId) {
      let legacyFields = [
          'assignmentId', 'learnerUid', 'submissionId', 'reviewerUid',
          'rubricVersion', 'courseVersion', 'assessmentVersion',
          'submissionSubmittedAt', 'scores', 'totalScore', 'decision',
          'publicFeedback', 'concern', 'privateNote', 'reviewedAt'
        ];
      let versionedFields = [
          'assignmentId', 'learnerUid', 'submissionId', 'courseId',
          'versionId', 'reviewerUid', 'rubricVersion', 'courseVersion',
          'assessmentVersion', 'submissionSubmittedAt', 'scores',
          'totalScore', 'decision', 'publicFeedback', 'concern',
          'privateNote', 'reviewedAt'
        ];
      return (
          (data.keys().hasAll(['versionId']) && data.keys().hasOnly(versionedFields))
          || (!data.keys().hasAny(['versionId', 'courseId']) && data.keys().hasOnly(legacyFields))
        )
        && data.assignmentId == resultId
        && data.learnerUid is string
        && data.learnerUid.size() >= 1
        && data.learnerUid.size() <= 128
        && data.reviewerUid == request.auth.uid
        && data.rubricVersion == 1
        && data.courseVersion is int
        && data.courseVersion >= 1
        && data.courseVersion <= 10000
        && data.assessmentVersion is int
        && data.assessmentVersion >= 1
        && data.assessmentVersion <= 10000
        && data.submissionSubmittedAt is timestamp
        && validReviewScores(data.scores)
        && data.totalScore is int
        && data.totalScore == rubricTotal(data.scores)
        && data.decision in ['approved', 'revision_requested']
        && data.publicFeedback is string
        && data.publicFeedback.size() >= 40
        && data.publicFeedback.size() <= 1500
        && data.concern in ['none', 'plagiarism', 'identity', 'consent', 'safeguarding']
        && data.privateNote is string
        && data.privateNote.size() <= 2000
        && (data.concern == 'none' || data.privateNote.size() >= 20)
        && data.reviewedAt == request.time
        && validReviewDecision(data)
        && validReviewBinding(data, resultId);
    }

    function validPublicReviewResult(data, resultId) {
      let legacyFields = [
          'assignmentId', 'learnerUid', 'submissionId', 'rubricVersion',
          'courseVersion', 'assessmentVersion', 'submissionSubmittedAt',
          'scores', 'totalScore', 'decision', 'publicFeedback', 'reviewedAt'
        ];
      let versionedFields = [
          'assignmentId', 'learnerUid', 'submissionId', 'courseId',
          'versionId', 'rubricVersion', 'courseVersion',
          'assessmentVersion', 'submissionSubmittedAt', 'scores',
          'totalScore', 'decision', 'publicFeedback', 'reviewedAt'
        ];
      return (
          (data.keys().hasAll(['versionId']) && data.keys().hasOnly(versionedFields))
          || (!data.keys().hasAny(['versionId', 'courseId']) && data.keys().hasOnly(legacyFields))
        )
        && data.assignmentId == resultId
        && data.learnerUid is string
        && data.learnerUid.size() >= 1
        && data.learnerUid.size() <= 128
        && data.rubricVersion == 1
        && data.courseVersion is int
        && data.courseVersion >= 1
        && data.courseVersion <= 10000
        && data.assessmentVersion is int
        && data.assessmentVersion >= 1
        && data.assessmentVersion <= 10000
        && data.submissionSubmittedAt is timestamp
        && validReviewScores(data.scores)
        && data.totalScore is int
        && data.totalScore == rubricTotal(data.scores)
        && data.decision in ['approved', 'revision_requested']
        && data.publicFeedback is string
        && data.publicFeedback.size() >= 40
        && data.publicFeedback.size() <= 1500
        && data.reviewedAt == request.time;
    }

    function samePublicReview(privateResult, publicResult) {
      return privateResult.assignmentId == publicResult.assignmentId
        && privateResult.learnerUid == publicResult.learnerUid
        && privateResult.submissionId == publicResult.submissionId
        && privateResult.rubricVersion == publicResult.rubricVersion
        && privateResult.courseVersion == publicResult.courseVersion
        && privateResult.assessmentVersion == publicResult.assessmentVersion
        && privateResult.submissionSubmittedAt == publicResult.submissionSubmittedAt
        && privateResult.scores == publicResult.scores
        && privateResult.totalScore == publicResult.totalScore
        && privateResult.decision == publicResult.decision
        && privateResult.publicFeedback == publicResult.publicFeedback
        && privateResult.reviewedAt == publicResult.reviewedAt
        && (
          (
            privateResult.keys().hasAll(['versionId', 'courseId'])
            && publicResult.keys().hasAll(['versionId', 'courseId'])
            && privateResult.versionId == publicResult.versionId
            && privateResult.courseId == publicResult.courseId
          )
          || (
            !privateResult.keys().hasAny(['versionId', 'courseId'])
            && !publicResult.keys().hasAny(['versionId', 'courseId'])
          )
        );
    }

    // Keep the original AI Foundations review path below Firestore's expression
    // ceiling. Versioned courses use the stricter validators above.
    function validLegacyReviewBindingFast(data, resultId) {
      let assignment = get(/databases/$(database)/documents/reviewAssignments/$(resultId)).data;
      let submission = get(/databases/$(database)/documents/users/$(data.learnerUid)/submissions/$(data.submissionId)).data;
      return assignment.assignmentId == resultId
        && assignment.learnerUid == data.learnerUid
        && assignment.submissionId == data.submissionId
        && assignment.reviewerUid == request.auth.uid
        && assignment.status == 'assigned'
        && submission.status == 'submitted'
        && submission.courseVersion == data.courseVersion
        && submission.assessmentVersion == data.assessmentVersion
        && submission.submittedAt == data.submissionSubmittedAt;
    }

    function validLegacyPrivateReviewResultFast(data, resultId) {
      return data.keys().hasOnly([
          'assignmentId', 'learnerUid', 'submissionId', 'reviewerUid',
          'rubricVersion', 'courseVersion', 'assessmentVersion',
          'submissionSubmittedAt', 'scores', 'totalScore', 'decision',
          'publicFeedback', 'concern', 'privateNote', 'reviewedAt'
        ])
        && data.assignmentId == resultId
        && data.learnerUid is string
        && data.learnerUid.size() >= 1
        && data.learnerUid.size() <= 128
        && validLegacySubmissionId(data.submissionId)
        && data.reviewerUid == request.auth.uid
        && data.rubricVersion == 1
        && data.courseVersion is int
        && data.courseVersion >= 1
        && data.courseVersion <= 10000
        && data.assessmentVersion == 1
        && data.submissionSubmittedAt is timestamp
        && validReviewScores(data.scores)
        && data.totalScore is int
        && data.totalScore == rubricTotal(data.scores)
        && data.decision in ['approved', 'revision_requested']
        && data.publicFeedback is string
        && data.publicFeedback.size() >= 40
        && data.publicFeedback.size() <= 1500
        && data.concern in ['none', 'plagiarism', 'identity', 'consent', 'safeguarding']
        && data.privateNote is string
        && data.privateNote.size() <= 2000
        && (data.concern == 'none' || data.privateNote.size() >= 20)
        && data.reviewedAt == request.time
        && validReviewDecision(data)
        && validLegacyReviewBindingFast(data, resultId);
    }

    function validLegacyPublicReviewResultFast(data, resultId) {
      return data.keys().hasOnly([
          'assignmentId', 'learnerUid', 'submissionId', 'rubricVersion',
          'courseVersion', 'assessmentVersion', 'submissionSubmittedAt',
          'scores', 'totalScore', 'decision', 'publicFeedback', 'reviewedAt'
        ])
        && data.assignmentId == resultId
        && data.learnerUid is string
        && data.learnerUid.size() >= 1
        && data.learnerUid.size() <= 128
        && validLegacySubmissionId(data.submissionId)
        && data.rubricVersion == 1
        && data.courseVersion is int
        && data.courseVersion >= 1
        && data.courseVersion <= 10000
        && data.assessmentVersion == 1
        && data.submissionSubmittedAt is timestamp
        && validReviewScores(data.scores)
        && data.totalScore is int
        && data.totalScore == rubricTotal(data.scores)
        && data.decision in ['approved', 'revision_requested']
        && data.publicFeedback is string
        && data.publicFeedback.size() >= 40
        && data.publicFeedback.size() <= 1500
        && data.reviewedAt == request.time;
    }

    function sameLegacyPublicReviewFast(privateResult, publicResult) {
      return privateResult.assignmentId == publicResult.assignmentId
        && privateResult.learnerUid == publicResult.learnerUid
        && privateResult.submissionId == publicResult.submissionId
        && privateResult.rubricVersion == publicResult.rubricVersion
        && privateResult.courseVersion == publicResult.courseVersion
        && privateResult.assessmentVersion == publicResult.assessmentVersion
        && privateResult.submissionSubmittedAt == publicResult.submissionSubmittedAt
        && privateResult.scores == publicResult.scores
        && privateResult.totalScore == publicResult.totalScore
        && privateResult.decision == publicResult.decision
        && privateResult.publicFeedback == publicResult.publicFeedback
        && privateResult.reviewedAt == publicResult.reviewedAt;
    }

    function validVersionedReviewBindingFast(data, resultId) {
      let assignment = get(/databases/$(database)/documents/reviewAssignments/$(resultId)).data;
      let submission = get(/databases/$(database)/documents/users/$(data.learnerUid)/submissions/$(data.submissionId)).data;
      return resultId == data.learnerUid + '--' + data.submissionId
        && data.submissionId in [
          data.versionId + '--project',
          data.versionId + '--project-revision-1'
        ]
        && assignment.assignmentId == resultId
        && assignment.learnerUid == data.learnerUid
        && assignment.submissionId == data.submissionId
        && assignment.reviewerUid == request.auth.uid
        && assignment.status == 'assigned'
        && submission.status == 'submitted'
        && submission.submissionId == data.submissionId
        && submission.courseId == data.courseId
        && submission.versionId == data.versionId
        && submission.courseVersion == data.courseVersion
        && submission.assessmentVersion == data.assessmentVersion
        && submission.submittedAt == data.submissionSubmittedAt;
    }

    function validVersionedPrivateReviewResultFast(data, resultId) {
      return data.keys().hasOnly([
          'assignmentId', 'learnerUid', 'submissionId', 'courseId',
          'versionId', 'reviewerUid', 'rubricVersion', 'courseVersion',
          'assessmentVersion', 'submissionSubmittedAt', 'scores',
          'totalScore', 'decision', 'publicFeedback', 'concern',
          'privateNote', 'reviewedAt'
        ])
        && data.assignmentId == resultId
        && data.learnerUid is string
        && data.learnerUid.size() >= 1
        && data.learnerUid.size() <= 128
        && data.reviewerUid == request.auth.uid
        && data.rubricVersion == 1
        && data.courseVersion is int
        && data.courseVersion >= 1
        && data.courseVersion <= 10000
        && data.assessmentVersion is int
        && data.assessmentVersion >= 1
        && data.assessmentVersion <= 10000
        && data.submissionSubmittedAt is timestamp
        && validReviewScores(data.scores)
        && data.totalScore is int
        && data.totalScore == rubricTotal(data.scores)
        && data.decision in ['approved', 'revision_requested']
        && data.publicFeedback is string
        && data.publicFeedback.size() >= 40
        && data.publicFeedback.size() <= 1500
        && data.concern in ['none', 'plagiarism', 'identity', 'consent', 'safeguarding']
        && data.privateNote is string
        && data.privateNote.size() <= 2000
        && (data.concern == 'none' || data.privateNote.size() >= 20)
        && data.reviewedAt == request.time
        && validReviewDecision(data)
        && validVersionedReviewBindingFast(data, resultId);
    }

    function validVersionedPublicReviewResultFast(data, resultId) {
      return data.keys().hasOnly([
          'assignmentId', 'learnerUid', 'submissionId', 'courseId',
          'versionId', 'rubricVersion', 'courseVersion',
          'assessmentVersion', 'submissionSubmittedAt', 'scores',
          'totalScore', 'decision', 'publicFeedback', 'reviewedAt'
        ])
        && data.assignmentId == resultId
        && data.learnerUid is string
        && data.learnerUid.size() >= 1
        && data.learnerUid.size() <= 128
        && data.rubricVersion == 1
        && data.courseVersion is int
        && data.courseVersion >= 1
        && data.courseVersion <= 10000
        && data.assessmentVersion is int
        && data.assessmentVersion >= 1
        && data.assessmentVersion <= 10000
        && data.submissionSubmittedAt is timestamp
        && validReviewScores(data.scores)
        && data.totalScore is int
        && data.totalScore == rubricTotal(data.scores)
        && data.decision in ['approved', 'revision_requested']
        && data.publicFeedback is string
        && data.publicFeedback.size() >= 40
        && data.publicFeedback.size() <= 1500
        && data.reviewedAt == request.time;
    }

    function sameVersionedPublicReviewFast(privateResult, publicResult) {
      return privateResult.assignmentId == publicResult.assignmentId
        && privateResult.learnerUid == publicResult.learnerUid
        && privateResult.submissionId == publicResult.submissionId
        && privateResult.courseId == publicResult.courseId
        && privateResult.versionId == publicResult.versionId
        && privateResult.rubricVersion == publicResult.rubricVersion
        && privateResult.courseVersion == publicResult.courseVersion
        && privateResult.assessmentVersion == publicResult.assessmentVersion
        && privateResult.submissionSubmittedAt == publicResult.submissionSubmittedAt
        && privateResult.scores == publicResult.scores
        && privateResult.totalScore == publicResult.totalScore
        && privateResult.decision == publicResult.decision
        && privateResult.publicFeedback == publicResult.publicFeedback
        && privateResult.reviewedAt == publicResult.reviewedAt;
    }

    function validPrivateReviewResultForWrite(data, resultId) {
      return data.keys().hasAll(['versionId'])
        ? validVersionedPrivateReviewResultFast(data, resultId)
        : validLegacyPrivateReviewResultFast(data, resultId);
    }

    function validPublicReviewResultForWrite(data, resultId) {
      return data.keys().hasAll(['versionId'])
        ? validVersionedPublicReviewResultFast(data, resultId)
        : validLegacyPublicReviewResultFast(data, resultId);
    }

    function samePublicReviewForWrite(privateResult, publicResult) {
      return privateResult.keys().hasAll(['versionId'])
        ? sameVersionedPublicReviewFast(privateResult, publicResult)
        : sameLegacyPublicReviewFast(privateResult, publicResult);
    }

    function validReviewAssignment(data, assignmentId) {
      let submission = get(/databases/$(database)/documents/users/$(data.learnerUid)/submissions/$(data.submissionId)).data;
      return data.keys().hasOnly([
          'assignmentId', 'learnerUid', 'submissionId', 'reviewerUid',
          'status', 'assignedAt', 'assignedBy'
        ])
        && data.assignmentId == assignmentId
        && data.learnerUid is string
        && data.learnerUid.size() >= 1
        && data.learnerUid.size() <= 128
        && assignmentId == data.learnerUid + '--' + data.submissionId
        && data.reviewerUid is string
        && data.reviewerUid.size() >= 1
        && data.reviewerUid.size() <= 128
        && data.reviewerUid != data.learnerUid
        && data.reviewerUid != request.auth.uid
        && data.status == 'assigned'
        && data.assignedAt == request.time
        && data.assignedBy == request.auth.uid
        && submission.status == 'submitted'
        && validSubmissionId(submission, data.submissionId);
    }

    function validCredentialId(credentialId) {
      return credentialId is string
        && credentialId.matches('EFBI-[0-9]{4}-[A-Z0-9]{12}');
    }

    function validLegacyCertificateRequest(data, uid, requestId) {
      let result = get(/databases/$(database)/documents/users/$(uid)/reviewResults/$(data.finalReviewId)).data;
      return data.keys().hasOnly([
          'requestId', 'learnerUid', 'courseId', 'publicName',
          'consentVersion', 'consentAcceptedAt', 'finalReviewId',
          'submissionId', 'courseVersion', 'assessmentVersion',
          'reviewedAt', 'status', 'createdAt'
        ])
        && requestId == 'ai-foundations'
        && data.requestId == requestId
        && data.learnerUid == uid
        && data.courseId == requestId
        && data.publicName is string
        && data.publicName.size() >= 2
        && data.publicName.size() <= 80
        && data.consentVersion == 'efbi-certificate-public-v1'
        && data.consentAcceptedAt == request.time
        && data.finalReviewId == uid + '--' + data.submissionId
        && validLegacySubmissionId(data.submissionId)
        && data.courseVersion is int
        && data.assessmentVersion == 1
        && data.reviewedAt is timestamp
        && data.status == 'requested'
        && data.createdAt == request.time
        && result.assignmentId == data.finalReviewId
        && result.learnerUid == uid
        && result.submissionId == data.submissionId
        && result.courseVersion == data.courseVersion
        && result.assessmentVersion == data.assessmentVersion
        && result.reviewedAt == data.reviewedAt
        && result.decision == 'approved';
    }

    function validVersionedCertificateRequest(data, uid, requestId) {
      let result = get(/databases/$(database)/documents/users/$(uid)/reviewResults/$(data.finalReviewId)).data;
      let version = get(/databases/$(database)/documents/courseVersions/$(data.versionId)).data;
      return data.keys().hasOnly([
          'requestId', 'learnerUid', 'courseId', 'courseTitle',
          'versionId', 'publicName', 'consentVersion',
          'consentAcceptedAt', 'finalReviewId', 'submissionId',
          'courseVersion', 'assessmentVersion', 'reviewedAt',
          'status', 'createdAt'
        ])
        && validCourseId(requestId)
        && data.requestId == requestId
        && data.learnerUid == uid
        && data.courseId == requestId
        && data.courseTitle is string
        && data.courseTitle.size() >= 5
        && data.courseTitle.size() <= 100
        && data.versionId is string
        && data.versionId.size() >= 8
        && data.versionId.size() <= 140
        && data.publicName is string
        && data.publicName.size() >= 2
        && data.publicName.size() <= 80
        && data.consentVersion == 'efbi-certificate-public-v1'
        && data.consentAcceptedAt == request.time
        && data.finalReviewId == uid + '--' + data.submissionId
        && data.submissionId in [
          data.versionId + '--project',
          data.versionId + '--project-revision-1'
        ]
        && data.courseVersion is int
        && data.assessmentVersion is int
        && data.reviewedAt is timestamp
        && data.status == 'requested'
        && data.createdAt == request.time
        && version.versionId == data.versionId
        && version.courseId == data.courseId
        && version.courseTitle == data.courseTitle
        && version.courseVersion == data.courseVersion
        && version.assessmentVersion == data.assessmentVersion
        && version.assessmentType == 'project'
        && result.assignmentId == data.finalReviewId
        && result.learnerUid == uid
        && result.submissionId == data.submissionId
        && result.courseId == data.courseId
        && result.versionId == data.versionId
        && result.courseVersion == data.courseVersion
        && result.assessmentVersion == data.assessmentVersion
        && result.reviewedAt == data.reviewedAt
        && result.decision == 'approved';
    }

    function validCertificateRequest(data, uid, requestId) {
      return data.keys().hasAll(['versionId'])
        ? validVersionedCertificateRequest(data, uid, requestId)
        : validLegacyCertificateRequest(data, uid, requestId);
    }

    function validCertificateClaim(data, claimId) {
      return data.keys().hasOnly([
          'claimId', 'learnerUid', 'courseId', 'currentCredentialId',
          'createdAt', 'updatedAt', 'lastAuditId'
        ])
        && data.claimId == claimId
        && claimId == data.learnerUid + '--' + data.courseId
        && data.learnerUid is string
        && data.learnerUid.size() >= 1
        && data.learnerUid.size() <= 128
        && validCourseId(data.courseId)
        && validCredentialId(data.currentCredentialId)
        && data.createdAt is timestamp
        && data.updatedAt == request.time
        && data.lastAuditId is string
        && data.lastAuditId.size() >= 16
        && data.lastAuditId.size() <= 180;
    }

    function validLegacyCertificateIssuance(data, credentialId) {
      let certificateRequest = get(/databases/$(database)/documents/users/$(data.learnerUid)/certificateRequests/ai-foundations).data;
      return data.keys().hasOnly([
          'credentialId', 'claimId', 'learnerUid', 'publicName', 'courseId',
          'courseTitle', 'finalReviewId', 'submissionId', 'courseVersion',
          'assessmentVersion', 'reviewedAt', 'issuedAt', 'issuedBy',
          'auditId', 'replacesCredentialId'
        ])
        && validCredentialId(credentialId)
        && data.credentialId == credentialId
        && data.claimId == data.learnerUid + '--ai-foundations'
        && data.learnerUid is string
        && data.learnerUid.size() >= 1
        && data.learnerUid.size() <= 128
        && data.publicName is string
        && data.publicName.size() >= 2
        && data.publicName.size() <= 80
        && data.courseId == 'ai-foundations'
        && data.courseTitle == 'AI Foundations for Ethiopia'
        && data.finalReviewId is string
        && validLegacySubmissionId(data.submissionId)
        && data.courseVersion is int
        && data.courseVersion >= 1
        && data.courseVersion <= 10000
        && data.assessmentVersion == 1
        && data.reviewedAt is timestamp
        && data.issuedAt == request.time
        && data.issuedBy == request.auth.uid
        && data.auditId is string
        && data.auditId.size() >= 16
        && data.auditId.size() <= 180
        && (data.replacesCredentialId == '' || validCredentialId(data.replacesCredentialId))
        && certificateRequest.status == 'requested'
        && certificateRequest.learnerUid == data.learnerUid
        && certificateRequest.publicName == data.publicName
        && certificateRequest.finalReviewId == data.finalReviewId
        && certificateRequest.submissionId == data.submissionId
        && certificateRequest.courseVersion == data.courseVersion
        && certificateRequest.assessmentVersion == data.assessmentVersion
        && certificateRequest.reviewedAt == data.reviewedAt;
    }

    function validVersionedCertificateIssuance(data, credentialId) {
      let certificateRequest = get(/databases/$(database)/documents/users/$(data.learnerUid)/certificateRequests/$(data.courseId)).data;
      return data.keys().hasOnly([
          'credentialId', 'claimId', 'learnerUid', 'publicName',
          'courseId', 'courseTitle', 'versionId', 'finalReviewId',
          'submissionId', 'courseVersion', 'assessmentVersion',
          'reviewedAt', 'issuedAt', 'issuedBy', 'auditId',
          'replacesCredentialId'
        ])
        && validCredentialId(credentialId)
        && data.credentialId == credentialId
        && data.claimId == data.learnerUid + '--' + data.courseId
        && data.learnerUid is string
        && data.learnerUid.size() >= 1
        && data.learnerUid.size() <= 128
        && data.publicName is string
        && data.publicName.size() >= 2
        && data.publicName.size() <= 80
        && validCourseId(data.courseId)
        && data.courseTitle is string
        && data.courseTitle.size() >= 5
        && data.courseTitle.size() <= 100
        && data.versionId is string
        && data.versionId.size() >= 8
        && data.versionId.size() <= 140
        && data.finalReviewId is string
        && data.submissionId in [
          data.versionId + '--project',
          data.versionId + '--project-revision-1'
        ]
        && data.courseVersion is int
        && data.courseVersion >= 1
        && data.courseVersion <= 10000
        && data.assessmentVersion is int
        && data.assessmentVersion >= 1
        && data.assessmentVersion <= 10000
        && data.reviewedAt is timestamp
        && data.issuedAt == request.time
        && data.issuedBy == request.auth.uid
        && data.auditId is string
        && data.auditId.size() >= 16
        && data.auditId.size() <= 180
        && (data.replacesCredentialId == '' || validCredentialId(data.replacesCredentialId))
        && certificateRequest.requestId == data.courseId
        && certificateRequest.status == 'requested'
        && certificateRequest.learnerUid == data.learnerUid
        && certificateRequest.courseId == data.courseId
        && certificateRequest.courseTitle == data.courseTitle
        && certificateRequest.versionId == data.versionId
        && certificateRequest.publicName == data.publicName
        && certificateRequest.finalReviewId == data.finalReviewId
        && certificateRequest.submissionId == data.submissionId
        && certificateRequest.courseVersion == data.courseVersion
        && certificateRequest.assessmentVersion == data.assessmentVersion
        && certificateRequest.reviewedAt == data.reviewedAt;
    }

    function validCertificateIssuance(data, credentialId) {
      return data.keys().hasAll(['versionId'])
        ? validVersionedCertificateIssuance(data, credentialId)
        : validLegacyCertificateIssuance(data, credentialId);
    }

    function validPublicCertificate(data, credentialId) {
      return data.keys().hasOnly([
          'credentialId', 'publicName', 'courseId', 'courseTitle',
          'issuedAt', 'replacesCredentialId'
        ])
        && validCredentialId(credentialId)
        && data.credentialId == credentialId
        && data.publicName is string
        && data.publicName.size() >= 2
        && data.publicName.size() <= 80
        && validCourseId(data.courseId)
        && data.courseTitle is string
        && data.courseTitle.size() >= 5
        && data.courseTitle.size() <= 100
        && data.issuedAt == request.time
        && (data.replacesCredentialId == '' || validCredentialId(data.replacesCredentialId));
    }

    function publicCertificateMatches(issuance, publicCertificate) {
      return issuance.credentialId == publicCertificate.credentialId
        && issuance.publicName == publicCertificate.publicName
        && issuance.courseId == publicCertificate.courseId
        && issuance.courseTitle == publicCertificate.courseTitle
        && issuance.issuedAt == publicCertificate.issuedAt
        && issuance.replacesCredentialId == publicCertificate.replacesCredentialId;
    }

    // Companion records trust only the immutable issuance created in the same
    // atomic package. The issuance rule remains the single full validator for
    // the request, reviewed work, course version, and every linked record.
    function certificateClaimMatchesIssuance(issuance, claim) {
      return issuance.claimId == claim.claimId
        && issuance.learnerUid == claim.learnerUid
        && issuance.courseId == claim.courseId
        && issuance.credentialId == claim.currentCredentialId
        && issuance.auditId == claim.lastAuditId
        && issuance.issuedAt == claim.updatedAt;
    }

    function activeCertificateStatusMatchesIssuance(issuance, status, credentialId) {
      return issuance.credentialId == credentialId
        && issuance.auditId == status.lastAuditId
        && issuance.issuedAt == status.updatedAt
        && status.status == 'active'
        && status.replacedBy == '';
    }

    function replacementStatusMatchesIssuance(issuance, status, credentialId) {
      return issuance.credentialId == status.replacedBy
        && issuance.replacesCredentialId == credentialId
        && issuance.auditId == status.lastAuditId
        && issuance.issuedAt == status.updatedAt;
    }

    function validCertificateStatus(data, credentialId) {
      return data.keys().hasOnly([
          'credentialId', 'status', 'updatedAt', 'replacedBy', 'lastAuditId'
        ])
        && validCredentialId(credentialId)
        && data.credentialId == credentialId
        && data.status in ['active', 'revoked', 'replaced']
        && data.updatedAt == request.time
        && data.replacedBy is string
        && (data.replacedBy == '' || validCredentialId(data.replacedBy))
        && data.lastAuditId is string
        && data.lastAuditId.size() >= 16
        && data.lastAuditId.size() <= 180;
    }

    function validCertificateAudit(data, eventId) {
      return data.keys().hasOnly([
          'eventId', 'action', 'credentialId', 'replacementCredentialId',
          'learnerUid', 'actorUid', 'reason', 'createdAt'
        ])
        && data.eventId == eventId
        && eventId.size() >= 16
        && eventId.size() <= 180
        && data.action in ['certificate.issued', 'certificate.revoked', 'certificate.replaced']
        && validCredentialId(data.credentialId)
        && data.replacementCredentialId is string
        && (data.replacementCredentialId == '' || validCredentialId(data.replacementCredentialId))
        && data.learnerUid is string
        && data.learnerUid.size() >= 1
        && data.learnerUid.size() <= 128
        && data.actorUid == request.auth.uid
        && data.reason is string
        && data.reason.size() >= 10
        && data.reason.size() <= 500
        && data.createdAt == request.time;
    }

    function initialCertificatePackage(issuance, credentialId) {
      let claim = getAfter(/databases/$(database)/documents/certificateClaims/$(issuance.claimId)).data;
      let publicCertificate = getAfter(/databases/$(database)/documents/certificates/$(credentialId)).data;
      let status = getAfter(/databases/$(database)/documents/certificateStatuses/$(credentialId)).data;
      let audit = getAfter(/databases/$(database)/documents/certificateAudit/$(issuance.auditId)).data;
      return issuance.replacesCredentialId == ''
        && !exists(/databases/$(database)/documents/certificateClaims/$(issuance.claimId))
        && claim.currentCredentialId == credentialId
        && claim.learnerUid == issuance.learnerUid
        && claim.courseId == issuance.courseId
        && claim.createdAt == request.time
        && claim.updatedAt == request.time
        && claim.lastAuditId == issuance.auditId
        && publicCertificateMatches(issuance, publicCertificate)
        && status.credentialId == credentialId
        && status.status == 'active'
        && status.replacedBy == ''
        && status.updatedAt == request.time
        && status.lastAuditId == issuance.auditId
        && audit.action == 'certificate.issued'
        && audit.credentialId == credentialId
        && audit.replacementCredentialId == ''
        && audit.learnerUid == issuance.learnerUid
        && audit.actorUid == request.auth.uid
        && audit.createdAt == request.time;
    }

    function replacementCertificatePackage(issuance, credentialId) {
      let oldIssuance = get(/databases/$(database)/documents/certificateIssuances/$(issuance.replacesCredentialId)).data;
      let oldStatus = get(/databases/$(database)/documents/certificateStatuses/$(issuance.replacesCredentialId)).data;
      let replacedStatus = getAfter(/databases/$(database)/documents/certificateStatuses/$(issuance.replacesCredentialId)).data;
      let oldClaim = get(/databases/$(database)/documents/certificateClaims/$(issuance.claimId)).data;
      let claim = getAfter(/databases/$(database)/documents/certificateClaims/$(issuance.claimId)).data;
      let status = getAfter(/databases/$(database)/documents/certificateStatuses/$(credentialId)).data;
      let publicCertificate = getAfter(/databases/$(database)/documents/certificates/$(credentialId)).data;
      let audit = getAfter(/databases/$(database)/documents/certificateAudit/$(issuance.auditId)).data;
      return validCredentialId(issuance.replacesCredentialId)
        && oldIssuance.claimId == issuance.claimId
        && oldIssuance.learnerUid == issuance.learnerUid
        && oldIssuance.courseId == issuance.courseId
        && oldStatus.status == 'active'
        && oldClaim.currentCredentialId == issuance.replacesCredentialId
        && claim.currentCredentialId == credentialId
        && claim.createdAt == oldClaim.createdAt
        && claim.updatedAt == request.time
        && claim.lastAuditId == issuance.auditId
        && replacedStatus.status == 'replaced'
        && replacedStatus.replacedBy == credentialId
        && replacedStatus.updatedAt == request.time
        && replacedStatus.lastAuditId == issuance.auditId
        && status.status == 'active'
        && status.replacedBy == ''
        && status.updatedAt == request.time
        && status.lastAuditId == issuance.auditId
        && publicCertificateMatches(issuance, publicCertificate)
        && audit.action == 'certificate.replaced'
        && audit.credentialId == issuance.replacesCredentialId
        && audit.replacementCredentialId == credentialId
        && audit.learnerUid == issuance.learnerUid
        && audit.actorUid == request.auth.uid
        && audit.createdAt == request.time;
    }

    function certificatePackageIsValid(issuance, credentialId) {
      return validCertificateIssuance(issuance, credentialId)
        && (
          initialCertificatePackage(issuance, credentialId)
          || replacementCertificatePackage(issuance, credentialId)
        );
    }

    function validRevocation(status, credentialId) {
      let issuance = get(/databases/$(database)/documents/certificateIssuances/$(credentialId)).data;
      let claim = get(/databases/$(database)/documents/certificateClaims/$(issuance.claimId)).data;
      let audit = getAfter(/databases/$(database)/documents/certificateAudit/$(status.lastAuditId)).data;
      return validCertificateStatus(status, credentialId)
        && resource.data.status == 'active'
        && status.status == 'revoked'
        && status.replacedBy == ''
        && claim.currentCredentialId == credentialId
        && audit.action == 'certificate.revoked'
        && audit.credentialId == credentialId
        && audit.replacementCredentialId == ''
        && audit.learnerUid == issuance.learnerUid
        && audit.actorUid == request.auth.uid
        && audit.createdAt == request.time;
    }

    function validDeletionRequest(data, uid) {
      return data.keys().hasOnly([
          'requestId', 'learnerUid', 'scope', 'policyVersion', 'status',
          'requestedAt', 'updatedAt', 'completedAt', 'certificateEvidenceRetained'
        ])
        && data.requestId == uid
        && data.learnerUid == uid
        && data.scope == 'account-and-learning-data'
        && data.policyVersion == 'efbi-retention-v1'
        && data.status in ['requested', 'cancelled', 'held', 'completed']
        && data.requestedAt is timestamp
        && data.updatedAt == request.time
        && (data.completedAt == null || data.completedAt is timestamp)
        && data.certificateEvidenceRetained is bool;
    }

    function learnerWritesAllowed(uid) {
      return !exists(/databases/$(database)/documents/deletionRequests/$(uid))
        || get(/databases/$(database)/documents/deletionRequests/$(uid)).data.status == 'cancelled';
    }

    function validRetentionHold(data, uid) {
      return data.keys().hasOnly([
          'holdId', 'learnerUid', 'status', 'reason', 'createdAt', 'createdBy',
          'updatedAt', 'updatedBy', 'auditId'
        ])
        && data.holdId == uid
        && data.learnerUid == uid
        && data.status in ['active', 'released']
        && data.reason is string
        && data.reason.size() >= 20
        && data.reason.size() <= 500
        && data.createdAt is timestamp
        && data.createdBy is string
        && data.createdBy.size() >= 1
        && data.createdBy.size() <= 128
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid
        && data.auditId is string
        && data.auditId.size() >= 16
        && data.auditId.size() <= 180;
    }

    function validDeletionCompletion(data, uid) {
      return data.keys().hasOnly([
          'completionId', 'learnerUid', 'policyVersion', 'completedAt',
          'certificateEvidenceRetained', 'authenticationRemoval',
          'deletedCategories', 'auditId'
        ])
        && data.completionId == uid
        && data.learnerUid == uid
        && data.policyVersion == 'efbi-retention-v1'
        && data.completedAt == request.time
        && data.certificateEvidenceRetained is bool
        && data.authenticationRemoval == 'manual-console-required'
        && data.deletedCategories is list
        && (
          (
            data.certificateEvidenceRetained == true
            && (
              data.deletedCategories == ['profile', 'courseProgress']
              || data.deletedCategories == [
                'profile', 'courseProgress', 'projectSubmissions',
                'reviewRecords', 'certificateRequest'
              ]
            )
          )
          || (
            data.certificateEvidenceRetained == false
            && data.deletedCategories == [
              'profile', 'courseProgress', 'projectSubmissions',
              'reviewRecords', 'certificateRequest'
            ]
          )
        )
        && data.auditId is string
        && data.auditId.size() >= 16
        && data.auditId.size() <= 180;
    }

    function validAuthenticationRemoval(data, uid) {
      return data.keys().hasOnly([
          'learnerUid', 'method', 'confirmedAt', 'confirmedBy', 'auditId'
        ])
        && data.learnerUid == uid
        && data.method == 'firebase-console-manual'
        && data.confirmedAt == request.time
        && data.confirmedBy == request.auth.uid
        && data.auditId is string
        && data.auditId.size() >= 16
        && data.auditId.size() <= 180;
    }
    function validRetentionAudit(data, eventId) {
      return data.keys().hasOnly([
          'eventId', 'action', 'learnerUid', 'actorUid', 'reason', 'createdAt'
        ])
        && data.eventId == eventId
        && eventId.size() >= 16
        && eventId.size() <= 180
        && data.action in [
          'retention.hold.created', 'retention.hold.released', 'deletion.completed',
          'authentication.removal.confirmed'
        ]
        && data.learnerUid is string
        && data.learnerUid.size() >= 1
        && data.learnerUid.size() <= 128
        && data.actorUid == request.auth.uid
        && data.reason is string
        && data.reason.size() >= 20
        && data.reason.size() <= 500
        && data.createdAt == request.time;
    }

    function retentionAuditLinked(data, eventId) {
      let deletionRequest = getAfter(/databases/$(database)/documents/deletionRequests/$(data.learnerUid)).data;
      let hold = getAfter(/databases/$(database)/documents/retentionHolds/$(data.learnerUid)).data;
      let completion = getAfter(/databases/$(database)/documents/deletionCompletions/$(data.learnerUid)).data;
      return (
          data.action == 'retention.hold.created'
          && hold.status == 'active'
          && hold.auditId == eventId
          && deletionRequest.status == 'held'
        )
        || (
          data.action == 'retention.hold.released'
          && hold.status == 'released'
          && hold.auditId == eventId
          && deletionRequest.status == 'requested'
        )
        || (
          data.action == 'deletion.completed'
          && completion.auditId == eventId
          && deletionRequest.status == 'completed'
          && completion.learnerUid == data.learnerUid
        )
        || (
          data.action == 'authentication.removal.confirmed'
          && getAfter(/databases/$(database)/documents/authenticationRemovals/$(data.learnerUid)).data.auditId == eventId
          && getAfter(/databases/$(database)/documents/authenticationRemovals/$(data.learnerUid)).data.learnerUid == data.learnerUid
          && deletionRequest.status == 'completed'
          && completion.learnerUid == data.learnerUid
        );
    }

    function basicLearnerRecordsGone(uid) {
      return !existsAfter(/databases/$(database)/documents/users/$(uid));
    }

    function deletionInventoryReadable(uid) {
      return admin()
        && get(/databases/$(database)/documents/deletionRequests/$(uid)).data.status == 'requested'
        && (
          !exists(/databases/$(database)/documents/retentionHolds/$(uid))
          || get(/databases/$(database)/documents/retentionHolds/$(uid)).data.status == 'released'
        );
    }

    function evidenceCourseId(data) {
      return data.keys().hasAll(['courseId'])
        ? data.courseId
        : 'ai-foundations';
    }

    function assignmentCourseId(data) {
      return data.keys().hasAll(['submissionId'])
        ? (
          get(/databases/$(database)/documents/users/$(data.learnerUid)/submissions/$(data.submissionId)).data.keys().hasAll(['courseId'])
            ? get(/databases/$(database)/documents/users/$(data.learnerUid)/submissions/$(data.submissionId)).data.courseId
            : 'ai-foundations'
        )
        : 'ai-foundations';
    }

    function deletionPackageValid(uid) {
      let deletionRequest = getAfter(/databases/$(database)/documents/deletionRequests/$(uid)).data;
      let completion = getAfter(/databases/$(database)/documents/deletionCompletions/$(uid)).data;
      let audit = getAfter(/databases/$(database)/documents/retentionAudit/$(completion.auditId)).data;
      let holdAllowsDeletion = !exists(/databases/$(database)/documents/retentionHolds/$(uid))
        || get(/databases/$(database)/documents/retentionHolds/$(uid)).data.status == 'released';
      return validDeletionRequest(deletionRequest, uid)
        && deletionRequest.status == 'completed'
        && deletionRequest.completedAt == request.time
        && deletionRequest.certificateEvidenceRetained == completion.certificateEvidenceRetained
        && validDeletionCompletion(completion, uid)
        && validRetentionAudit(audit, completion.auditId)
        && audit.action == 'deletion.completed'
        && audit.learnerUid == uid
        && holdAllowsDeletion
        && basicLearnerRecordsGone(uid);
    }

    function evidenceDeletionAllowed(uid, courseId) {
      return admin()
        && validCourseId(courseId)
        && !exists(/databases/$(database)/documents/certificateClaims/$(uid + '--' + courseId))
        && deletionPackageValid(uid);
    }
    match /deletionRequests/{uid} {
      allow get: if owns(uid) || admin();
      allow list: if admin();
      allow create: if owns(uid)
        && hasLearnerProfile(uid)
        && validDeletionRequest(request.resource.data, uid)
        && request.resource.data.status == 'requested'
        && request.resource.data.requestedAt == request.time
        && request.resource.data.completedAt == null
        && request.resource.data.certificateEvidenceRetained == false;
      allow update: if validDeletionRequest(request.resource.data, uid)
        && (
          (
            owns(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            && (
              (resource.data.status == 'requested' && request.resource.data.status == 'cancelled')
              || (resource.data.status == 'cancelled' && request.resource.data.status == 'requested')
            )
          )
          || (
            admin()
            && (
              (
                resource.data.status == 'requested'
                && request.resource.data.status == 'held'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
                && getAfter(/databases/$(database)/documents/retentionHolds/$(uid)).data.status == 'active'
                && getAfter(/databases/$(database)/documents/retentionAudit/$(getAfter(/databases/$(database)/documents/retentionHolds/$(uid)).data.auditId)).data.action == 'retention.hold.created'
              )
              || (
                resource.data.status == 'held'
                && request.resource.data.status == 'requested'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
                && getAfter(/databases/$(database)/documents/retentionHolds/$(uid)).data.status == 'released'
                && getAfter(/databases/$(database)/documents/retentionAudit/$(getAfter(/databases/$(database)/documents/retentionHolds/$(uid)).data.auditId)).data.action == 'retention.hold.released'
              )
              || (
                resource.data.status == 'requested'
                && request.resource.data.status == 'completed'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'status', 'updatedAt', 'completedAt', 'certificateEvidenceRetained'
                ])
                && deletionPackageValid(uid)
              )
            )
          )
        );
      allow delete: if false;
    }

    match /retentionHolds/{uid} {
      allow get, list: if admin();
      allow create: if admin()
        && validRetentionHold(request.resource.data, uid)
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && get(/databases/$(database)/documents/deletionRequests/$(uid)).data.status == 'requested'
        && getAfter(/databases/$(database)/documents/deletionRequests/$(uid)).data.status == 'held'
        && validRetentionAudit(
          getAfter(/databases/$(database)/documents/retentionAudit/$(request.resource.data.auditId)).data,
          request.resource.data.auditId
        )
        && getAfter(/databases/$(database)/documents/retentionAudit/$(request.resource.data.auditId)).data.action == 'retention.hold.created';
      allow update: if admin()
        && validRetentionHold(request.resource.data, uid)
        && (
          (
            resource.data.status == 'active'
            && request.resource.data.status == 'released'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'reason', 'updatedAt', 'updatedBy', 'auditId'
            ])
            && get(/databases/$(database)/documents/deletionRequests/$(uid)).data.status == 'held'
            && getAfter(/databases/$(database)/documents/deletionRequests/$(uid)).data.status == 'requested'
            && getAfter(/databases/$(database)/documents/retentionAudit/$(request.resource.data.auditId)).data.action == 'retention.hold.released'
          )
          || (
            resource.data.status == 'released'
            && request.resource.data.status == 'active'
            && request.resource.data.createdAt == request.time
            && request.resource.data.createdBy == request.auth.uid
            && get(/databases/$(database)/documents/deletionRequests/$(uid)).data.status == 'requested'
            && getAfter(/databases/$(database)/documents/deletionRequests/$(uid)).data.status == 'held'
            && getAfter(/databases/$(database)/documents/retentionAudit/$(request.resource.data.auditId)).data.action == 'retention.hold.created'
          )
        )
        && validRetentionAudit(
          getAfter(/databases/$(database)/documents/retentionAudit/$(request.resource.data.auditId)).data,
          request.resource.data.auditId
        );
      allow delete: if false;
    }

    match /deletionCompletions/{uid} {
      allow get: if owns(uid) || admin();
      allow list: if admin();
      allow create: if admin()
        && validDeletionCompletion(request.resource.data, uid)
        && deletionPackageValid(uid);
      allow update, delete: if false;
    }

    match /authenticationRemovals/{uid} {
      allow get: if owns(uid) || admin();
      allow list: if admin();
      allow create: if admin()
        && validAuthenticationRemoval(request.resource.data, uid)
        && get(/databases/$(database)/documents/deletionRequests/$(uid)).data.status == 'completed'
        && get(/databases/$(database)/documents/deletionCompletions/$(uid)).data.learnerUid == uid
        && validRetentionAudit(
          getAfter(/databases/$(database)/documents/retentionAudit/$(request.resource.data.auditId)).data,
          request.resource.data.auditId
        )
        && getAfter(/databases/$(database)/documents/retentionAudit/$(request.resource.data.auditId)).data.action == 'authentication.removal.confirmed';
      allow update, delete: if false;
    }
    match /retentionAudit/{eventId} {
      allow get, list: if admin();
      allow create: if admin()
        && validRetentionAudit(request.resource.data, eventId)
        && retentionAuditLinked(request.resource.data, eventId);
      allow update, delete: if false;
    }
    match /publicSettings/{settingId} {
      allow get: if settingId == 'enrollment';
      allow list: if false;
      allow create, update: if settingId == 'enrollment' && admin() && validEnrollmentSettings(request.resource.data);
      allow delete: if false;
    }

    // Each published course version is immutable. The active-course document is
    // a narrow pointer that lets new progress records lock to one reviewed version.
    match /courseVersions/{versionId} {
      allow get, list: if verified();
      allow create: if admin()
        && validCourseVersion(request.resource.data, versionId)
        && linkedAuditIsValid(
          request.resource.data.auditId,
          'course.version.activated',
          'courseVersion',
          request.resource.data.courseId,
          request.resource.data.courseVersion,
          versionId
        );
      allow update, delete: if false;
    }

    match /activeCourses/{courseId} {
      allow get, list: if verified();
      allow create, update: if admin()
        && validActiveCourse(request.resource.data, courseId)
        && linkedAuditIsValid(
          request.resource.data.auditId,
          'course.version.activated',
          'courseVersion',
          courseId,
          request.resource.data.courseVersion,
          request.resource.data.versionId
        );
      allow delete: if false;
    }

    // A deliberately narrow pre-registration catalog. It contains course
    // marketing details and lesson outlines, never lesson bodies or answer keys.
    match /publicCourseCatalog/{courseId} {
      allow get, list: if true;
      allow create, update: if admin()
        && validPublicCourseCatalog(request.resource.data, courseId)
        && linkedAuditIsValid(
          getAfter(/databases/$(database)/documents/courseVersions/$(request.resource.data.versionId)).data.auditId,
          'course.version.activated',
          'courseVersion',
          courseId,
          request.resource.data.courseVersion,
          request.resource.data.versionId
        );
      allow delete: if false;
    }

    match /users/{uid} {
      allow create: if owns(uid) && enrollmentOpen() && learnerWritesAllowed(uid) && validProfile(request.resource.data);
      allow get: if owns(uid) || admin();
      allow list: if admin();
      allow update: if owns(uid)
        && learnerWritesAllowed(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt'])
        && validDisplayName(request.resource.data.displayName)
        && request.resource.data.updatedAt == request.time;
      allow delete: if admin() && deletionPackageValid(uid);

      match /progress/{courseId} {
        allow get, list: if owns(uid) || admin();
        allow create: if owns(uid)
          && verified()
          && hasLearnerProfile(uid)
          && learnerWritesAllowed(uid)
          && validProgress(request.resource.data, courseId)
          && (request.resource.data.keys().hasAll(['versionId'])
            ? versionedProgressStartsAtFirstLesson(request.resource.data, courseId)
            : (
              courseId == 'ai-foundations'
              && request.resource.data.completedLessonIds == ['understanding-ai']
              && request.resource.data.createdAt == request.time
            )
          );
        allow update: if owns(uid)
          && verified()
          && hasLearnerProfile(uid)
          && learnerWritesAllowed(uid)
          && validProgress(request.resource.data, courseId)
          && (request.resource.data.keys().hasAll(['versionId'])
            ? versionedProgressAddsNextLesson(request.resource.data, resource.data, courseId)
            : (
              courseId == 'ai-foundations'
              && !resource.data.keys().hasAny(['versionId'])
              && request.resource.data.createdAt == resource.data.createdAt
              && request.resource.data.completedLessonIds.size() == resource.data.completedLessonIds.size() + 1
              && request.resource.data.percent == resource.data.percent + 25
              && resource.data.completedLessonIds.toSet()
                .difference(request.resource.data.completedLessonIds.toSet()).size() == 0
            )
          );
        allow delete: if admin() && deletionPackageValid(uid);
      }

      match /submissions/{submissionId} {
        allow get: if owns(uid)
          || (admin() && resource.data.status == 'submitted')
          || assignedReviewer(uid, submissionId);
        allow list: if owns(uid)
          || (admin() && resource.data.status == 'submitted')
          || deletionInventoryReadable(uid);
        allow create: if owns(uid)
          && verified()
          && hasLearnerProfile(uid)
          && learnerWritesAllowed(uid)
          && completedSubmissionCourse(uid, request.resource.data)
          && validSubmissionDraft(request.resource.data, submissionId, uid)
          && request.resource.data.createdAt == request.time
          && (
            originalSubmission(request.resource.data, submissionId)
            || (
              revisionSubmission(request.resource.data, submissionId)
              && revisionIsAllowed(uid, request.resource.data)
            )
          );
        allow update: if owns(uid)
          && verified()
          && hasLearnerProfile(uid)
          && learnerWritesAllowed(uid)
          && (
            request.resource.data.keys().hasAll(['versionId'])
            ? (
              submissionId == request.resource.data.versionId + '--project'
              ? versionedOriginalSubmissionUpdateAllowed(uid, submissionId)
              : versionedRevisionSubmissionUpdateAllowed(uid, submissionId)
            )
            : legacySubmissionUpdateAllowed(uid, submissionId)
          );
        allow delete: if evidenceDeletionAllowed(uid, evidenceCourseId(resource.data));
      }

      // Learners receive a separate public-safe result. The linked private
      // reviewer note and concern category never enter this learner-owned path.
      match /reviewResults/{resultId} {
        allow get, list: if owns(uid) || admin();
        allow create: if reviewer()
          && learnerWritesAllowed(uid)
          && request.resource.data.learnerUid == uid
          && validPublicReviewResultForWrite(request.resource.data, resultId)
          && validPrivateReviewResultForWrite(
            getAfter(/databases/$(database)/documents/reviewResults/$(resultId)).data,
            resultId
          )
          && samePublicReviewForWrite(
            getAfter(/databases/$(database)/documents/reviewResults/$(resultId)).data,
            request.resource.data
          );
        allow update: if false;
        allow delete: if evidenceDeletionAllowed(uid, evidenceCourseId(resource.data));
      }

      // An approved learner deliberately chooses the name that may appear in
      // public certificate verification. The request is immutable.
      match /certificateRequests/{requestId} {
        allow get: if owns(uid) || admin();
        allow list: if owns(uid) || admin();
        allow create: if owns(uid)
          && verified()
          && hasLearnerProfile(uid)
          && learnerWritesAllowed(uid)
          && validCertificateRequest(request.resource.data, uid, requestId);
        allow update: if false;
        allow delete: if evidenceDeletionAllowed(uid, evidenceCourseId(resource.data));
      }
    }

    // Collection-group queries are limited to submitted work for administrators.
    // Learner drafts remain private even from the administration interface.
    match /{path=**}/submissions/{submissionId} {
      allow list: if admin() && resource.data.status == 'submitted';
    }

    match /{path=**}/certificateRequests/{requestId} {
      allow list: if admin();
    }

    // Public verification exposes only the learner-authorized name and core
    // credential fields. Status is stored separately so issuance never changes.
    match /certificates/{credentialId} {
      allow get: if true;
      allow list: if false;
      allow create: if admin()
        && validPublicCertificate(request.resource.data, credentialId)
        && publicCertificateMatches(
          getAfter(/databases/$(database)/documents/certificateIssuances/$(credentialId)).data,
          request.resource.data
        );
      allow update, delete: if false;
    }

    match /certificateIssuances/{credentialId} {
      allow get, list: if admin();
      allow create: if admin()
        && learnerWritesAllowed(request.resource.data.learnerUid)
        && certificatePackageIsValid(request.resource.data, credentialId);
      allow update, delete: if false;
    }

    match /certificateClaims/{claimId} {
      allow get: if admin() || (signedIn() && resource.data.learnerUid == request.auth.uid);
      allow list: if admin();
      allow create: if admin()
        && validCertificateClaim(request.resource.data, claimId)
        && request.resource.data.createdAt == request.time
        && certificateClaimMatchesIssuance(
          getAfter(/databases/$(database)/documents/certificateIssuances/$(request.resource.data.currentCredentialId)).data,
          request.resource.data
        )
        && getAfter(/databases/$(database)/documents/certificateIssuances/$(request.resource.data.currentCredentialId)).data.replacesCredentialId == ''
        && request.resource.data.updatedAt == request.resource.data.createdAt;
      allow update: if admin()
        && validCertificateClaim(request.resource.data, claimId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'currentCredentialId', 'updatedAt', 'lastAuditId'
        ])
        && certificateClaimMatchesIssuance(
          getAfter(/databases/$(database)/documents/certificateIssuances/$(request.resource.data.currentCredentialId)).data,
          request.resource.data
        )
        && getAfter(/databases/$(database)/documents/certificateIssuances/$(request.resource.data.currentCredentialId)).data.replacesCredentialId == resource.data.currentCredentialId;
      allow delete: if false;
    }

    match /certificateStatuses/{credentialId} {
      allow get: if true;
      allow list: if false;
      allow create: if admin()
        && validCertificateStatus(request.resource.data, credentialId)
        && activeCertificateStatusMatchesIssuance(
          getAfter(/databases/$(database)/documents/certificateIssuances/$(credentialId)).data,
          request.resource.data,
          credentialId
        );
      allow update: if admin()
        && (
          validRevocation(request.resource.data, credentialId)
          || (
            validCertificateStatus(request.resource.data, credentialId)
            && resource.data.status == 'active'
            && request.resource.data.status == 'replaced'
            && validCredentialId(request.resource.data.replacedBy)
            && replacementStatusMatchesIssuance(
              getAfter(/databases/$(database)/documents/certificateIssuances/$(request.resource.data.replacedBy)).data,
              request.resource.data,
              credentialId
            )
          )
        );
      allow delete: if false;
    }

    match /certificateAudit/{eventId} {
      allow get, list: if admin();
      allow create: if admin()
        && validCertificateAudit(request.resource.data, eventId)
        && (
          (
            request.resource.data.action == 'certificate.issued'
            && request.resource.data.replacementCredentialId == ''
            && getAfter(/databases/$(database)/documents/certificateIssuances/$(request.resource.data.credentialId)).data.auditId == eventId
            && getAfter(/databases/$(database)/documents/certificateIssuances/$(request.resource.data.credentialId)).data.learnerUid == request.resource.data.learnerUid
          )
          || (
            request.resource.data.action == 'certificate.replaced'
            && validCredentialId(request.resource.data.replacementCredentialId)
            && getAfter(/databases/$(database)/documents/certificateIssuances/$(request.resource.data.replacementCredentialId)).data.auditId == eventId
            && getAfter(/databases/$(database)/documents/certificateIssuances/$(request.resource.data.replacementCredentialId)).data.replacesCredentialId == request.resource.data.credentialId
            && getAfter(/databases/$(database)/documents/certificateIssuances/$(request.resource.data.replacementCredentialId)).data.learnerUid == request.resource.data.learnerUid
          )
          || (
            request.resource.data.action == 'certificate.revoked'
            && request.resource.data.replacementCredentialId == ''
            && getAfter(/databases/$(database)/documents/certificateStatuses/$(request.resource.data.credentialId)).data.status == 'revoked'
            && getAfter(/databases/$(database)/documents/certificateStatuses/$(request.resource.data.credentialId)).data.lastAuditId == eventId
            && get(/databases/$(database)/documents/certificateIssuances/$(request.resource.data.credentialId)).data.learnerUid == request.resource.data.learnerUid
          )
        );
      allow update, delete: if false;
    }

    // Blog drafts remain private. Publication creates an immutable release and
    // public projection. Unpublishing deletes only that projection and preserves history.
    match /blogDrafts/{postId} {
      allow get, list: if admin();
      allow create: if admin()
        && validBlogDraft(request.resource.data, postId)
        && request.resource.data.status == 'draft'
        && request.resource.data.revision == 1
        && request.resource.data.latestReleaseNumber == 0
        && request.resource.data.latestReleaseId == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && linkedAuditIsValid(request.resource.data.lastAuditId, 'blog.draft.created', 'blogDraft', postId, 1, '');
      allow update: if admin()
        && validBlogDraft(request.resource.data, postId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.revision == resource.data.revision + 1
        && (
          (
            request.resource.data.status in ['draft', 'ready']
            && (request.resource.data.status != resource.data.status || !sameBlogContent())
            && request.resource.data.latestReleaseNumber == resource.data.latestReleaseNumber
            && request.resource.data.latestReleaseId == resource.data.latestReleaseId
            && linkedAuditIsValid(request.resource.data.lastAuditId, 'blog.draft.updated', 'blogDraft', postId, request.resource.data.revision, request.resource.data.latestReleaseId)
          )
          || (
            resource.data.status == 'ready'
            && request.resource.data.status == 'published'
            && sameBlogContent()
            && request.resource.data.latestReleaseNumber == resource.data.latestReleaseNumber + 1
            && request.resource.data.latestReleaseId != ''
            && request.resource.data.latestReleaseId != resource.data.latestReleaseId
            && linkedAuditIsValid(request.resource.data.lastAuditId, 'blog.release.published', 'blogRelease', postId, request.resource.data.revision, request.resource.data.latestReleaseId)
            && getAfter(/databases/$(database)/documents/blogReleases/$(request.resource.data.latestReleaseId)).data.postId == postId
            && getAfter(/databases/$(database)/documents/blogReleases/$(request.resource.data.latestReleaseId)).data.auditId == request.resource.data.lastAuditId
            && getAfter(/databases/$(database)/documents/publishedPosts/$(postId)).data.releaseId == request.resource.data.latestReleaseId
            && getAfter(/databases/$(database)/documents/publishedPosts/$(postId)).data.auditId == request.resource.data.lastAuditId
          )
          || (
            resource.data.status == 'published'
            && request.resource.data.status == 'unpublished'
            && sameBlogContent()
            && request.resource.data.latestReleaseNumber == resource.data.latestReleaseNumber
            && request.resource.data.latestReleaseId == resource.data.latestReleaseId
            && exists(/databases/$(database)/documents/publishedPosts/$(postId))
            && !existsAfter(/databases/$(database)/documents/publishedPosts/$(postId))
            && linkedAuditIsValid(request.resource.data.lastAuditId, 'blog.post.unpublished', 'blogDraft', postId, request.resource.data.revision, request.resource.data.latestReleaseId)
          )
        );
      allow delete: if false;
    }

    match /blogReleases/{releaseId} {
      allow get, list: if admin();
      allow create: if admin()
        && validBlogRelease(request.resource.data, releaseId)
        && linkedAuditIsValid(request.resource.data.auditId, 'blog.release.published', 'blogRelease', request.resource.data.postId, request.resource.data.draftRevision, releaseId)
        && blogReleaseMatchesDraft(request.resource.data, releaseId)
        && getAfter(/databases/$(database)/documents/publishedPosts/$(request.resource.data.postId)).data.releaseId == releaseId;
      allow update, delete: if false;
    }

    match /publishedPosts/{postId} {
      allow get, list: if true;
      allow create: if admin()
        && validPublishedPost(request.resource.data, postId)
        && publishedPostMatchesRelease(request.resource.data, postId)
        && linkedAuditIsValid(request.resource.data.auditId, 'blog.release.published', 'blogRelease', postId, getAfter(/databases/$(database)/documents/blogReleases/$(request.resource.data.releaseId)).data.draftRevision, request.resource.data.releaseId);
      allow update: if admin()
        && validPublishedPost(request.resource.data, postId)
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.releaseId != resource.data.releaseId
        && publishedPostMatchesRelease(request.resource.data, postId)
        && linkedAuditIsValid(request.resource.data.auditId, 'blog.release.published', 'blogRelease', postId, getAfter(/databases/$(database)/documents/blogReleases/$(request.resource.data.releaseId)).data.draftRevision, request.resource.data.releaseId);
      allow delete: if admin()
        && getAfter(/databases/$(database)/documents/blogDrafts/$(postId)).data.status == 'unpublished'
        && getAfter(/databases/$(database)/documents/blogDrafts/$(postId)).data.latestReleaseId == resource.data.releaseId
        && linkedAuditIsValid(
          getAfter(/databases/$(database)/documents/blogDrafts/$(postId)).data.lastAuditId,
          'blog.post.unpublished',
          'blogDraft',
          postId,
          getAfter(/databases/$(database)/documents/blogDrafts/$(postId)).data.revision,
          resource.data.releaseId
        );
    }

    // Program drafts remain private. Publishing atomically creates an immutable
    // release, refreshes the public program snapshot, and records one audit event.
    match /programDrafts/{programId} {
      allow get, list: if admin();
      allow create: if admin()
        && validProgramDraft(request.resource.data, programId)
        && request.resource.data.status == 'draft'
        && request.resource.data.revision == 1
        && request.resource.data.latestReleaseNumber == 0
        && request.resource.data.latestReleaseId == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && linkedAuditIsValid(
          request.resource.data.lastAuditId,
          'program.draft.created',
          'programDraft',
          programId,
          1,
          ''
        );
      allow update: if admin()
        && validProgramDraft(request.resource.data, programId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.revision == resource.data.revision + 1
        && (
          (
            request.resource.data.status in ['draft', 'ready']
            && (request.resource.data.status != resource.data.status || !sameProgramContent())
            && request.resource.data.latestReleaseNumber == resource.data.latestReleaseNumber
            && request.resource.data.latestReleaseId == resource.data.latestReleaseId
            && linkedAuditIsValid(
              request.resource.data.lastAuditId,
              'program.draft.updated',
              'programDraft',
              programId,
              request.resource.data.revision,
              request.resource.data.latestReleaseId
            )
          )
          || (
            resource.data.status == 'ready'
            && request.resource.data.status == 'published'
            && sameProgramContent()
            && request.resource.data.latestReleaseNumber == resource.data.latestReleaseNumber + 1
            && request.resource.data.latestReleaseId != ''
            && request.resource.data.latestReleaseId != resource.data.latestReleaseId
            && linkedAuditIsValid(
              request.resource.data.lastAuditId,
              'program.release.published',
              'programRelease',
              programId,
              request.resource.data.revision,
              request.resource.data.latestReleaseId
            )
            && getAfter(/databases/$(database)/documents/programReleases/$(request.resource.data.latestReleaseId)).data.programId == programId
            && getAfter(/databases/$(database)/documents/programReleases/$(request.resource.data.latestReleaseId)).data.auditId == request.resource.data.lastAuditId
            && getAfter(/databases/$(database)/documents/publishedPrograms/$(programId)).data.releaseId == request.resource.data.latestReleaseId
            && getAfter(/databases/$(database)/documents/publishedPrograms/$(programId)).data.auditId == request.resource.data.lastAuditId
          )
        );
      allow delete: if false;
    }

    match /programReleases/{releaseId} {
      allow get, list: if admin();
      allow create: if admin()
        && validProgramRelease(request.resource.data, releaseId)
        && linkedAuditIsValid(
          request.resource.data.auditId,
          'program.release.published',
          'programRelease',
          request.resource.data.programId,
          request.resource.data.draftRevision,
          releaseId
        )
        && programReleaseMatchesDraft(request.resource.data, releaseId)
        && getAfter(/databases/$(database)/documents/publishedPrograms/$(request.resource.data.programId)).data.releaseId == releaseId;
      allow update, delete: if false;
    }

    match /publishedPrograms/{programId} {
      allow get, list: if true;
      allow create: if admin()
        && validPublishedProgram(request.resource.data, programId)
        && request.resource.data.version == 1
        && publishedProgramMatchesRelease(request.resource.data, programId)
        && linkedAuditIsValid(
          request.resource.data.auditId,
          'program.release.published',
          'programRelease',
          programId,
          getAfter(/databases/$(database)/documents/programReleases/$(request.resource.data.releaseId)).data.draftRevision,
          request.resource.data.releaseId
        );
      allow update: if admin()
        && validPublishedProgram(request.resource.data, programId)
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.releaseId != resource.data.releaseId
        && publishedProgramMatchesRelease(request.resource.data, programId)
        && linkedAuditIsValid(
          request.resource.data.auditId,
          'program.release.published',
          'programRelease',
          programId,
          getAfter(/databases/$(database)/documents/programReleases/$(request.resource.data.releaseId)).data.draftRevision,
          request.resource.data.releaseId
        );
      allow delete: if false;
    }

    // Drafts remain private. Every accepted change requires a linked immutable
    // audit event written in the same atomic operation.
    match /courseDrafts/{courseId} {
      allow get, list: if admin();
      allow create: if admin()
        && validCourseDraft(request.resource.data, courseId)
        && request.resource.data.status == 'draft'
        && request.resource.data.revision == 1
        && request.resource.data.latestReleaseNumber == 0
        && request.resource.data.latestReleaseId == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && linkedAuditIsValid(
          request.resource.data.lastAuditId,
          'course.draft.created',
          'courseDraft',
          courseId,
          1,
          ''
        );
      allow update: if admin()
        && validCourseDraft(request.resource.data, courseId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.revision == resource.data.revision + 1
        && (
          (
            request.resource.data.status in ['draft', 'ready']
            && (request.resource.data.status != resource.data.status
              || !sameCourseContent())
            && request.resource.data.latestReleaseNumber == resource.data.latestReleaseNumber
            && request.resource.data.latestReleaseId == resource.data.latestReleaseId
            && linkedAuditIsValid(
              request.resource.data.lastAuditId,
              'course.draft.updated',
              'courseDraft',
              courseId,
              request.resource.data.revision,
              request.resource.data.latestReleaseId
            )
          )
          ||
          (
            resource.data.status == 'ready'
            && request.resource.data.status == 'published'
            && sameCourseContent()
            && request.resource.data.latestReleaseNumber == resource.data.latestReleaseNumber + 1
            && request.resource.data.latestReleaseId != ''
            && request.resource.data.latestReleaseId != resource.data.latestReleaseId
            && linkedAuditIsValid(
              request.resource.data.lastAuditId,
              'course.release.published',
              'courseRelease',
              courseId,
              request.resource.data.revision,
              request.resource.data.latestReleaseId
            )
            && getAfter(/databases/$(database)/documents/courseReleases/$(request.resource.data.latestReleaseId)).data.courseId == courseId
            && getAfter(/databases/$(database)/documents/courseReleases/$(request.resource.data.latestReleaseId)).data.version == request.resource.data.latestReleaseNumber
            && getAfter(/databases/$(database)/documents/courseReleases/$(request.resource.data.latestReleaseId)).data.draftRevision == request.resource.data.revision
            && getAfter(/databases/$(database)/documents/courseReleases/$(request.resource.data.latestReleaseId)).data.auditId == request.resource.data.lastAuditId
          )
        );
      allow delete: if false;

      match /{document=**} {
        allow read: if admin();
        allow write: if false;
      }
    }

    // Published releases are immutable snapshots. The student catalog will use them
    // student catalog after migration and compatibility tests.
    match /courseReleases/{releaseId} {
      allow get, list: if verified();
      allow create: if admin()
        && validCourseRelease(request.resource.data, releaseId)
        && linkedAuditIsValid(
          request.resource.data.auditId,
          'course.release.published',
          'courseRelease',
          request.resource.data.courseId,
          request.resource.data.draftRevision,
          releaseId
        )
        && releaseMatchesPublishedDraft(request.resource.data, releaseId);
      allow update, delete: if false;
    }

    // Lesson drafts are private authoring records. Published lesson snapshots are
    // still kept out of the student route until migration is tested.
    match /lessonDrafts/{lessonId} {
      allow get, list: if admin();
      allow create: if admin()
        && validLessonDraft(request.resource.data, lessonId)
        && request.resource.data.status == 'draft'
        && request.resource.data.revision == 1
        && request.resource.data.latestReleaseNumber == 0
        && request.resource.data.latestReleaseId == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && linkedAuditIsValid(
          request.resource.data.lastAuditId,
          'lesson.draft.created',
          'lessonDraft',
          lessonId,
          1,
          ''
        );
      allow update: if admin()
        && request.resource.data.status in ['draft', 'ready']
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.revision == resource.data.revision + 1
        && validLessonDraft(request.resource.data, lessonId)
        && (request.resource.data.status != resource.data.status || !sameLessonContent())
        && request.resource.data.latestReleaseNumber == resource.data.latestReleaseNumber
        && request.resource.data.latestReleaseId == resource.data.latestReleaseId
        && linkedAuditIsValid(
          request.resource.data.lastAuditId,
          'lesson.draft.updated',
          'lessonDraft',
          lessonId,
          request.resource.data.revision,
          ''
        );
      allow update: if admin()
        && resource.data.status == 'ready'
        && request.resource.data.status == 'published'
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.revision == resource.data.revision + 1
        && validLessonPublishDraft(request.resource.data, lessonId)
        && sameLessonContent()
        && request.resource.data.latestReleaseNumber == resource.data.latestReleaseNumber + 1
        && request.resource.data.latestReleaseId != resource.data.latestReleaseId
        && linkedAuditIsValid(
          request.resource.data.lastAuditId,
          'lesson.release.published',
          'lessonRelease',
          lessonId,
          request.resource.data.revision,
          request.resource.data.latestReleaseId
        );
      allow delete: if false;
    }
    // Published lesson releases are immutable snapshots. The student route will
    // use them only after the catalog migration has its own compatibility tests.
    match /lessonReleases/{releaseId} {
      allow get, list: if verified();
      allow create: if admin()
        && validLessonRelease(request.resource.data, releaseId)
        && linkedAuditIsValid(
          request.resource.data.auditId,
          'lesson.release.published',
          'lessonRelease',
          request.resource.data.lessonId,
          request.resource.data.draftRevision,
          releaseId
        )
        && releaseMatchesPublishedLessonDraft(request.resource.data, releaseId);
      allow update, delete: if false;
    }
    // The private result is readable only by administrators and its assigned
    // reviewer. It must be created atomically with a matching learner-safe copy.
    match /reviewResults/{resultId} {
      allow get: if admin()
        || (
          reviewer()
          && get(/databases/$(database)/documents/reviewAssignments/$(resultId)).data.reviewerUid == request.auth.uid
          && get(/databases/$(database)/documents/reviewAssignments/$(resultId)).data.status == 'assigned'
        );
      allow list: if admin()
        || (reviewer() && resource.data.reviewerUid == request.auth.uid);
      allow create: if reviewer()
        && learnerWritesAllowed(request.resource.data.learnerUid)
        && validPrivateReviewResultForWrite(request.resource.data, resultId)
        && validPublicReviewResultForWrite(
          getAfter(/databases/$(database)/documents/users/$(request.resource.data.learnerUid)/reviewResults/$(resultId)).data,
          resultId
        )
        && samePublicReviewForWrite(
          request.resource.data,
          getAfter(/databases/$(database)/documents/users/$(request.resource.data.learnerUid)/reviewResults/$(resultId)).data
        );
      allow update: if false;
      allow delete: if admin()
        && (
          !exists(/databases/$(database)/documents/reviewResults/$(resultId))
          || evidenceDeletionAllowed(
            resource.data.learnerUid,
            evidenceCourseId(resource.data)
          )
        );
    }

    match /reviewAssignments/{assignmentId} {
      allow get, list: if admin()
        || (reviewer() && resource.data.reviewerUid == request.auth.uid);
      allow create: if admin()
        && learnerWritesAllowed(request.resource.data.learnerUid)
        && validReviewAssignment(request.resource.data, assignmentId);
      allow update: if false;
      allow delete: if admin()
        && (
          !exists(/databases/$(database)/documents/reviewAssignments/$(assignmentId))
          || evidenceDeletionAllowed(
            resource.data.learnerUid,
            assignmentCourseId(resource.data)
          )
        );
    }

    match /adminAudit/{eventId} {
      allow get, list: if admin();
      allow create: if admin()
        && validAuditEvent(request.resource.data, eventId)
        && auditLinksToCourseOperation(request.resource.data, eventId);
      allow update, delete: if false;
    }

    match /courses/{courseId} {
      allow read: if verified();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
