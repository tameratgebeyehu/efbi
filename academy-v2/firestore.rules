    function validVersionedOriginalDraftFast(data, submissionId) {
      return validVersionedOriginalSubmissionShapeFast(data, submissionId)
        && data.status == 'draft'
        && validEvidence(data.evidence, false)
        && data.consentVersion == ''
        && data.consentAcceptedAt == null
        && data.submittedAt == null;
