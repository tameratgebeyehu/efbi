    function auditLinksToCourseDraft(data, eventId) {
      let draft = getAfter(/databases/$(database)/documents/courseDrafts/$(data.entityId)).data;
      return data.action in ['course.draft.created', 'course.draft.updated']
        && draft.lastAuditId == eventId
        && draft.revision == data.revision
        && draft.latestReleaseId == data.releaseId
        && draft.updatedBy == request.auth.uid;
    }

    function auditLinksToCourseVersion(data, eventId) {
      let version = getAfter(/databases/$(database)/documents/courseVersions/$(data.releaseId)).data;
      let active = getAfter(/databases/$(database)/documents/activeCourses/$(data.entityId)).data;
      return data.action == 'course.version.activated'
        && version.courseId == data.entityId
        && version.courseVersion == data.revision
        && version.auditId == eventId
        && version.publishedBy == request.auth.uid
        && active.versionId == data.releaseId
        && active.auditId == eventId
        && active.activatedBy == request.auth.uid;
    }

    function auditLinksToCourseRelease(data, eventId) {
      let draft = getAfter(/databases/$(database)/documents/courseDrafts/$(data.entityId)).data;
      let release = getAfter(/databases/$(database)/documents/courseReleases/$(data.releaseId)).data;
      return data.action == 'course.release.published'
        && draft.status == 'published'
        && draft.lastAuditId == eventId
        && draft.revision == data.revision
        && draft.latestReleaseId == data.releaseId
        && draft.updatedBy == request.auth.uid
        && release.auditId == eventId
        && release.courseId == data.entityId
        && release.publishedBy == request.auth.uid;
    }

    function auditLinksToLessonDraft(data, eventId) {
      let lesson = getAfter(/databases/$(database)/documents/lessonDrafts/$(data.entityId)).data;
      return data.action in ['lesson.draft.created', 'lesson.draft.updated']
        && lesson.lastAuditId == eventId
        && lesson.revision == data.revision
        && lesson.updatedBy == request.auth.uid
        && data.releaseId == '';
    }

    function auditLinksToLessonRelease(data, eventId) {
      let lesson = getAfter(/databases/$(database)/documents/lessonDrafts/$(data.entityId)).data;
      let release = getAfter(/databases/$(database)/documents/lessonReleases/$(data.releaseId)).data;
      return data.action == 'lesson.release.published'
        && lesson.status == 'published'
        && lesson.lastAuditId == eventId
        && lesson.revision == data.revision
        && lesson.latestReleaseId == data.releaseId
        && lesson.updatedBy == request.auth.uid
        && release.auditId == eventId
        && release.lessonId == data.entityId
        && release.publishedBy == request.auth.uid;
    }

    function auditLinksToProgramDraft(data, eventId) {
      let draft = getAfter(/databases/$(database)/documents/programDrafts/$(data.entityId)).data;
      return data.action in ['program.draft.created', 'program.draft.updated']
        && draft.lastAuditId == eventId
        && draft.revision == data.revision
        && draft.latestReleaseId == data.releaseId
        && draft.updatedBy == request.auth.uid;
    }

    function auditLinksToProgramRelease(data, eventId) {
      let draft = getAfter(/databases/$(database)/documents/programDrafts/$(data.entityId)).data;
      let release = getAfter(/databases/$(database)/documents/programReleases/$(data.releaseId)).data;
      let published = getAfter(/databases/$(database)/documents/publishedPrograms/$(data.entityId)).data;
      return data.action == 'program.release.published'
        && draft.status == 'published'
        && draft.lastAuditId == eventId
        && draft.revision == data.revision
        && draft.latestReleaseId == data.releaseId
        && draft.updatedBy == request.auth.uid
        && release.auditId == eventId
        && release.programId == data.entityId
        && release.publishedBy == request.auth.uid
        && published.auditId == eventId
        && published.releaseId == data.releaseId
        && published.publishedBy == request.auth.uid;
    }

    function auditLinksToBlogDraft(data, eventId) {
      let draft = getAfter(/databases/$(database)/documents/blogDrafts/$(data.entityId)).data;
      return data.action in ['blog.draft.created', 'blog.draft.updated']
        && draft.lastAuditId == eventId
        && draft.revision == data.revision
        && draft.latestReleaseId == data.releaseId
        && draft.updatedBy == request.auth.uid;
    }

    function auditLinksToBlogRelease(data, eventId) {
      let draft = getAfter(/databases/$(database)/documents/blogDrafts/$(data.entityId)).data;
      let release = getAfter(/databases/$(database)/documents/blogReleases/$(data.releaseId)).data;
      let published = getAfter(/databases/$(database)/documents/publishedPosts/$(data.entityId)).data;
      return data.action == 'blog.release.published'
        && draft.status == 'published'
        && draft.lastAuditId == eventId
        && draft.revision == data.revision
        && draft.latestReleaseId == data.releaseId
        && draft.updatedBy == request.auth.uid
        && release.auditId == eventId
        && release.postId == data.entityId
        && release.publishedBy == request.auth.uid
        && published.auditId == eventId
        && published.releaseId == data.releaseId
        && published.publishedBy == request.auth.uid;
    }

    function auditLinksToBlogUnpublish(data, eventId) {
      let draft = getAfter(/databases/$(database)/documents/blogDrafts/$(data.entityId)).data;
      return data.action == 'blog.post.unpublished'
        && draft.status == 'unpublished'
        && draft.lastAuditId == eventId
        && draft.revision == data.revision
        && draft.latestReleaseId == data.releaseId
        && draft.updatedBy == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/publishedPosts/$(data.entityId));
    }

    function auditLinksToCourseOperation(data, eventId) {
      return data.entityType == 'courseDraft'
        ? auditLinksToCourseDraft(data, eventId)
        : data.entityType == 'courseVersion'
          ? auditLinksToCourseVersion(data, eventId)
          : data.entityType == 'courseRelease'
            ? auditLinksToCourseRelease(data, eventId)
            : data.entityType == 'lessonDraft'
              ? auditLinksToLessonDraft(data, eventId)
              : data.entityType == 'lessonRelease'
                ? auditLinksToLessonRelease(data, eventId)
                : data.entityType == 'programDraft'
                  ? auditLinksToProgramDraft(data, eventId)
                  : data.entityType == 'programRelease'
                    ? auditLinksToProgramRelease(data, eventId)
                    : data.entityType == 'blogRelease'
                      ? auditLinksToBlogRelease(data, eventId)
                      : data.entityType == 'blogDraft'
                        ? (data.action == 'blog.post.unpublished'
                          ? auditLinksToBlogUnpublish(data, eventId)
                          : auditLinksToBlogDraft(data, eventId))
                        : false;
    }

    function validLegacySubmissionId(submissionId) {
      return submissionId in [
        'ai-foundations-project', 'ai-foundations-project-revision-1'
      ];
    }

    function versionedOriginalSubmissionId(data) {
      return data.versionId + '--project';
    }

    function versionedRevisionSubmissionId(data) {
      return data.versionId + '--project-revision-1';
    }

    function validSubmissionId(data, submissionId) {
      return data.keys().hasAll(['versionId'])
        ? submissionId in [
            versionedOriginalSubmissionId(data),
            versionedRevisionSubmissionId(data)
          ]
        : validLegacySubmissionId(submissionId);
    }

    function validEvidenceLink(value) {
      return value is string
        && value.size() >= 12
        && value.size() <= 500
        && value.matches('https://[A-Za-z0-9.-]+(/[A-Za-z0-9._~:/?#@&=+,%!-]*)?');
    }

    function validEvidence(evidence, required) {
      return evidence is list
        && evidence.size() <= 3
        && (required == false || evidence.size() >= 1)
        && (evidence.size() < 1 || validEvidenceLink(evidence[0]))
        && (evidence.size() < 2 || validEvidenceLink(evidence[1]))
        && (evidence.size() < 3 || validEvidenceLink(evidence[2]));
    }

    function validLegacySubmissionShape(data, submissionId, uid) {
      let originalFields = [
          'submissionId', 'courseId', 'courseVersion', 'assessmentVersion',
          'projectTitle', 'problemStatement', 'intendedUsers', 'solutionSummary',
          'evidence', 'reflection', 'aiUseDisclosure', 'consentVersion',
          'consentAcceptedAt', 'status', 'createdAt', 'updatedAt', 'submittedAt'
        ];
      let revisionFields = [
          'submissionId', 'courseId', 'courseVersion', 'assessmentVersion',
          'projectTitle', 'problemStatement', 'intendedUsers', 'solutionSummary',
          'evidence', 'reflection', 'aiUseDisclosure', 'consentVersion',
          'consentAcceptedAt', 'status', 'createdAt', 'updatedAt', 'submittedAt',
          'originalSubmissionId', 'revisionNumber', 'basedOnReviewId',
          'originalSubmittedAt', 'basedOnReviewReviewedAt'
        ];
      return (
          (submissionId == 'ai-foundations-project' && data.keys().hasOnly(originalFields))
          || (
            submissionId == 'ai-foundations-project-revision-1'
            && data.keys().hasOnly(revisionFields)
            && data.originalSubmissionId == 'ai-foundations-project'
            && data.revisionNumber == 1
            && data.basedOnReviewId == uid + '--ai-foundations-project'
            && data.originalSubmittedAt is timestamp
            && data.basedOnReviewReviewedAt is timestamp
            && data.originalSubmittedAt == get(/databases/$(database)/documents/users/$(uid)/submissions/ai-foundations-project).data.submittedAt
            && data.basedOnReviewReviewedAt == get(/databases/$(database)/documents/users/$(uid)/reviewResults/$(uid + '--ai-foundations-project')).data.reviewedAt
            && data.courseVersion == get(/databases/$(database)/documents/users/$(uid)/submissions/ai-foundations-project).data.courseVersion
            && data.assessmentVersion == get(/databases/$(database)/documents/users/$(uid)/submissions/ai-foundations-project).data.assessmentVersion
          )
        )
        && validLegacySubmissionId(submissionId)
        && data.submissionId == submissionId
        && data.courseId == 'ai-foundations'
        && data.courseVersion is int
        && data.courseVersion >= 1
        && data.courseVersion <= 10000
        && data.assessmentVersion == 1
        && data.projectTitle is string
        && data.projectTitle.size() <= 100
        && data.problemStatement is string
        && data.problemStatement.size() <= 1200
        && data.intendedUsers is string
        && data.intendedUsers.size() <= 600
        && data.solutionSummary is string
        && data.solutionSummary.size() <= 2000
        && data.reflection is string
        && data.reflection.size() <= 2000
        && data.aiUseDisclosure is string
        && data.aiUseDisclosure.size() <= 1200
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function validVersionedSubmissionShape(data, submissionId, uid) {
      let version = get(/databases/$(database)/documents/courseVersions/$(data.versionId)).data;
      let originalId = versionedOriginalSubmissionId(data);
      let original = get(/databases/$(database)/documents/users/$(uid)/submissions/$(originalId)).data;
      let originalReviewId = uid + '--' + originalId;
      let originalReview = get(/databases/$(database)/documents/users/$(uid)/reviewResults/$(originalReviewId)).data;
      let originalFields = [
          'submissionId', 'courseId', 'versionId', 'courseVersion',
          'assessmentVersion', 'projectTitle', 'problemStatement',
          'intendedUsers', 'solutionSummary', 'evidence', 'reflection',
          'aiUseDisclosure', 'consentVersion', 'consentAcceptedAt',
          'status', 'createdAt', 'updatedAt', 'submittedAt'
        ];
      let revisionFields = [
          'submissionId', 'courseId', 'versionId', 'courseVersion',
          'assessmentVersion', 'projectTitle', 'problemStatement',
          'intendedUsers', 'solutionSummary', 'evidence', 'reflection',
          'aiUseDisclosure', 'consentVersion', 'consentAcceptedAt',
          'status', 'createdAt', 'updatedAt', 'submittedAt',
          'originalSubmissionId', 'revisionNumber', 'basedOnReviewId',
          'originalSubmittedAt', 'basedOnReviewReviewedAt'
        ];
      return (
          (
            submissionId == originalId
            && data.keys().hasOnly(originalFields)
          )
          || (
            submissionId == versionedRevisionSubmissionId(data)
            && data.keys().hasOnly(revisionFields)
            && data.originalSubmissionId == originalId
            && data.revisionNumber == 1
            && data.basedOnReviewId == originalReviewId
            && data.originalSubmittedAt is timestamp
            && data.basedOnReviewReviewedAt is timestamp
            && data.originalSubmittedAt == original.submittedAt
            && data.basedOnReviewReviewedAt == originalReview.reviewedAt
            && data.courseVersion == original.courseVersion
            && data.assessmentVersion == original.assessmentVersion
            && data.versionId == original.versionId
          )
        )
        && validSubmissionId(data, submissionId)
        && data.submissionId == submissionId
        && validCourseId(data.courseId)
        && data.versionId is string
        && data.versionId.size() >= 8
        && data.versionId.size() <= 140
        && version.versionId == data.versionId
        && version.courseId == data.courseId
        && version.courseVersion == data.courseVersion
        && version.assessmentVersion == data.assessmentVersion
        && version.assessmentType == 'project'
        && data.courseVersion is int
        && data.assessmentVersion is int
        && data.projectTitle is string
        && data.projectTitle.size() <= 100
        && data.problemStatement is string
        && data.problemStatement.size() <= 1200
        && data.intendedUsers is string
        && data.intendedUsers.size() <= 600
        && data.solutionSummary is string
        && data.solutionSummary.size() <= 2000
        && data.reflection is string
        && data.reflection.size() <= 2000
        && data.aiUseDisclosure is string
        && data.aiUseDisclosure.size() <= 1200
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function validSubmissionShape(data, submissionId, uid) {
      return data.keys().hasAll(['versionId'])
        ? validVersionedSubmissionShape(data, submissionId, uid)
        : validLegacySubmissionShape(data, submissionId, uid);
    }

    function validSubmissionDraft(data, submissionId, uid) {
      return validSubmissionShape(data, submissionId, uid)
        && data.status == 'draft'
        && validEvidence(data.evidence, false)
        && data.consentVersion == ''
        && data.consentAcceptedAt == null
        && data.submittedAt == null;
    }

    function validFinalSubmission(data, submissionId, uid) {
      return validSubmissionShape(data, submissionId, uid)
        && data.status == 'submitted'
        && data.projectTitle.size() >= 5
        && data.problemStatement.size() >= 40
        && data.intendedUsers.size() >= 10
        && data.solutionSummary.size() >= 50
        && data.reflection.size() >= 50
        && data.aiUseDisclosure.size() >= 20
        && validEvidence(data.evidence, true)
        && (
          (!data.keys().hasAny(['originalSubmissionId'])
            && data.consentVersion == 'efbi-project-consent-v1')
          ||
          (data.keys().hasAll(['originalSubmissionId'])
            && data.consentVersion == 'efbi-project-revision-consent-v1')
        )
        && data.consentAcceptedAt == request.time
        && data.submittedAt == request.time;
    }

    function completedAiFoundations(uid) {
      let progress = get(/databases/$(database)/documents/users/$(uid)/progress/ai-foundations).data;
      return progress.courseId == 'ai-foundations'
        && progress.percent == 100
        && progress.completedLessonIds == ['understanding-ai', 'prompting-with-purpose', 'responsible-use', 'build-an-ethiopian-solution'];
    }

    function completedVersionedSubmissionCourse(uid, data) {
      let progress = get(/databases/$(database)/documents/users/$(uid)/progress/$(data.courseId)).data;
      let version = get(/databases/$(database)/documents/courseVersions/$(data.versionId)).data;
      return progress.courseId == data.courseId
        && progress.versionId == data.versionId
        && progress.courseVersion == data.courseVersion
        && progress.lessonCount == version.lessonIds.size()
        && progress.completedLessonIds.size() == progress.lessonCount
        && progress.completedLessonIds.toSet()
          .difference(version.lessonIds.toSet()).size() == 0
        && version.versionId == data.versionId
        && version.courseId == data.courseId
        && version.courseVersion == data.courseVersion
        && version.assessmentVersion == data.assessmentVersion
        && version.assessmentType == 'project';
    }

    function completedSubmissionCourse(uid, data) {
      return data.keys().hasAll(['versionId'])
        ? completedVersionedSubmissionCourse(uid, data)
        : completedAiFoundations(uid);
    }

    function validLegacySubmissionDraftFast(data, submissionId, uid) {
      return validLegacySubmissionShape(data, submissionId, uid)
        && data.status == 'draft'
        && validEvidence(data.evidence, false)
        && data.consentVersion == ''
        && data.consentAcceptedAt == null
        && data.submittedAt == null;
    }

    function validLegacyFinalSubmissionFast(data, submissionId, uid) {
      return validLegacySubmissionShape(data, submissionId, uid)
        && data.status == 'submitted'
        && data.projectTitle.size() >= 5
        && data.problemStatement.size() >= 40
        && data.intendedUsers.size() >= 10
        && data.solutionSummary.size() >= 50
        && data.reflection.size() >= 50
        && data.aiUseDisclosure.size() >= 20
        && validEvidence(data.evidence, true)
        && (
          (submissionId == 'ai-foundations-project'
            && data.consentVersion == 'efbi-project-consent-v1')
          ||
          (submissionId == 'ai-foundations-project-revision-1'
            && data.consentVersion == 'efbi-project-revision-consent-v1')
        )
        && data.consentAcceptedAt == request.time
        && data.submittedAt == request.time;
    }

    function legacyRevisionIsAllowed(uid) {
      let original = get(/databases/$(database)/documents/users/$(uid)/submissions/ai-foundations-project).data;
      let result = get(/databases/$(database)/documents/users/$(uid)/reviewResults/$(uid + '--ai-foundations-project')).data;
      return original.status == 'submitted'
        && result.learnerUid == uid
        && result.submissionId == 'ai-foundations-project'
        && result.decision == 'revision_requested';
    }

    function sameLegacySubmissionIdentity() {
      return request.resource.data.submissionId == resource.data.submissionId
        && request.resource.data.courseId == resource.data.courseId
        && request.resource.data.courseVersion == resource.data.courseVersion
        && request.resource.data.assessmentVersion == resource.data.assessmentVersion
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function legacySubmissionUpdateAllowed(uid, submissionId) {
      return completedAiFoundations(uid)
        && resource.data.status == 'draft'
        && sameLegacySubmissionIdentity()
        && (
          submissionId == 'ai-foundations-project'
          || (
            submissionId == 'ai-foundations-project-revision-1'
            && legacyRevisionIsAllowed(uid)
          )
        )
        && (
          validLegacySubmissionDraftFast(request.resource.data, submissionId, uid)
          || validLegacyFinalSubmissionFast(request.resource.data, submissionId, uid)
        );
    }

    function validVersionedOriginalSubmissionShapeFast(data, submissionId) {
      let version = get(/databases/$(database)/documents/courseVersions/$(data.versionId)).data;
      return data.keys().hasOnly([
          'submissionId', 'courseId', 'versionId', 'courseVersion',
          'assessmentVersion', 'projectTitle', 'problemStatement',
          'intendedUsers', 'solutionSummary', 'evidence', 'reflection',
          'aiUseDisclosure', 'consentVersion', 'consentAcceptedAt',
          'status', 'createdAt', 'updatedAt', 'submittedAt'
        ])
        && submissionId == data.versionId + '--project'
        && data.submissionId == submissionId
        && validCourseId(data.courseId)
        && data.versionId is string
        && data.versionId.size() >= 8
        && data.versionId.size() <= 140
        && version.versionId == data.versionId
        && version.courseId == data.courseId
        && version.courseVersion == data.courseVersion
        && version.assessmentVersion == data.assessmentVersion
        && version.assessmentType == 'project'
        && data.courseVersion is int
        && data.assessmentVersion is int
        && data.projectTitle is string
        && data.projectTitle.size() <= 100
        && data.problemStatement is string
        && data.problemStatement.size() <= 1200
        && data.intendedUsers is string
        && data.intendedUsers.size() <= 600
        && data.solutionSummary is string
        && data.solutionSummary.size() <= 2000
        && data.reflection is string
        && data.reflection.size() <= 2000
        && data.aiUseDisclosure is string
        && data.aiUseDisclosure.size() <= 1200
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function validVersionedRevisionSubmissionShapeFast(data, submissionId, uid) {
      let version = get(/databases/$(database)/documents/courseVersions/$(data.versionId)).data;
      let originalId = data.versionId + '--project';
      let reviewId = uid + '--' + originalId;
      let original = get(/databases/$(database)/documents/users/$(uid)/submissions/$(originalId)).data;
      let review = get(/databases/$(database)/documents/users/$(uid)/reviewResults/$(reviewId)).data;
      return data.keys().hasOnly([
          'submissionId', 'courseId', 'versionId', 'courseVersion',
          'assessmentVersion', 'projectTitle', 'problemStatement',
          'intendedUsers', 'solutionSummary', 'evidence', 'reflection',
          'aiUseDisclosure', 'consentVersion', 'consentAcceptedAt',
          'status', 'createdAt', 'updatedAt', 'submittedAt',
          'originalSubmissionId', 'revisionNumber', 'basedOnReviewId',
          'originalSubmittedAt', 'basedOnReviewReviewedAt'
        ])
        && submissionId == data.versionId + '--project-revision-1'
        && data.submissionId == submissionId
        && data.originalSubmissionId == originalId
        && data.revisionNumber == 1
        && data.basedOnReviewId == reviewId
        && data.originalSubmittedAt is timestamp
        && data.basedOnReviewReviewedAt is timestamp
        && original.status == 'submitted'
        && original.submittedAt == data.originalSubmittedAt
        && original.courseId == data.courseId
        && original.versionId == data.versionId
        && original.courseVersion == data.courseVersion
        && original.assessmentVersion == data.assessmentVersion
        && review.learnerUid == uid
        && review.submissionId == originalId
        && review.reviewedAt == data.basedOnReviewReviewedAt
        && review.decision == 'revision_requested'
        && validCourseId(data.courseId)
        && data.versionId is string
        && data.versionId.size() >= 8
        && data.versionId.size() <= 140
        && version.versionId == data.versionId
        && version.courseId == data.courseId
        && version.courseVersion == data.courseVersion
        && version.assessmentVersion == data.assessmentVersion
        && version.assessmentType == 'project'
        && data.courseVersion is int
        && data.assessmentVersion is int
        && data.projectTitle is string
        && data.projectTitle.size() <= 100
        && data.problemStatement is string
        && data.problemStatement.size() <= 1200
        && data.intendedUsers is string
        && data.intendedUsers.size() <= 600
        && data.solutionSummary is string
        && data.solutionSummary.size() <= 2000
        && data.reflection is string
        && data.reflection.size() <= 2000
        && data.aiUseDisclosure is string
        && data.aiUseDisclosure.size() <= 1200
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function sameVersionedSubmissionIdentityFast() {
      return request.resource.data.submissionId == resource.data.submissionId
        && request.resource.data.courseId == resource.data.courseId
        && request.resource.data.versionId == resource.data.versionId
        && request.resource.data.courseVersion == resource.data.courseVersion
        && request.resource.data.assessmentVersion == resource.data.assessmentVersion
        && request.resource.data.createdAt == resource.data.createdAt;
