    function validAuditEvent(data, eventId) {
      return data.keys().hasOnly([
          'eventId', 'action', 'entityType', 'entityId', 'actorUid',
          'revision', 'releaseId', 'createdAt'
        ])
        && data.eventId == eventId
        && data.action in ['course.draft.created', 'course.draft.updated', 'course.release.published', 'course.version.activated', 'lesson.draft.created', 'lesson.draft.updated', 'lesson.release.published', 'program.draft.created', 'program.draft.updated', 'program.release.published', 'blog.draft.created', 'blog.draft.updated', 'blog.release.published', 'blog.post.unpublished']
        && data.entityType in ['courseDraft', 'courseRelease', 'courseVersion', 'lessonDraft', 'lessonRelease', 'programDraft', 'programRelease', 'blogDraft', 'blogRelease']
        && (data.entityType in ['blogDraft', 'blogRelease'] ? validPostId(data.entityId) : validCourseId(data.entityId))
        && data.actorUid == request.auth.uid
        && data.revision is int
        && data.revision >= 1
        && data.releaseId is string
        && data.releaseId.size() <= 120
        && data.createdAt == request.time;
